# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Google Search Console (scripts/gsc-*.js) -------------------------------
# From a Google Cloud service-account JSON key. The service account also needs
# to be added to the property in Search Console under Settings → Users and
# permissions; Cloud project access alone returns 403.
GSC_CLIENT_EMAIL=
# Paste the full key including the BEGIN/END lines. Keep the literal \n
# escapes and wrap the value in double quotes.
GSC_PRIVATE_KEY=
# Domain property (sc-domain:example.com) or URL-prefix property
# (https://example.com/) — must match how the property is registered.
GSC_SITE_URL=

# --- Google Analytics 4 (scripts/ga4-report.js) -----------------------------
# The NUMERIC property ID from GA4 Admin → Property Settings — not the
# G-XXXXXXX measurement ID that ships in BaseLayout.astro.
GA4_PROPERTY_ID=
# Service-account credentials for the GA4 Data API. Leave both blank to reuse
# GSC_CLIENT_EMAIL/GSC_PRIVATE_KEY above when it is the same service account.
# Either way the account must be added in GA4 Admin → Property access
# management as a Viewer; Cloud project access alone returns 403, same as GSC.
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# --- Admin session signing (src/pages/admin/*) -----------------------------
# Secret behind the 8-hour signed admin session token. The cookie stores the
# derived token, never this value.
ADMIN_SECRET=

# --- Lead capture (src/pages/quote-submit.ts) -------------------------------
# n8n Production Webhook URL for the /request-a-quote form. n8n owns the
# GoHighLevel contact write and the prospect auto-reply, so no GHL credential
# belongs in this file. When unset, submissions are logged (with contact
# details, so leads are recoverable) but not delivered.
N8N_QUOTE_WEBHOOK_URL=
# Shared secret sent as X-TVCT-Webhook-Secret so n8n can reject anyone who
# merely knows the webhook URL. Must match the n8n webhook node's Header Auth
# credential exactly — change both together or every lead 403s.
N8N_QUOTE_WEBHOOK_SECRET=

# --- Optional tooling ------------------------------------------------------
# scripts/pagespeed-audit.js
PAGESPEED_API_KEY=
# scripts/generate-all-content.mjs
OPENAI_API_KEY=
