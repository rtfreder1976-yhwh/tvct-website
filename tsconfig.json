{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "moduleResolution": "bundler"
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "api/**/*",
    "astro.config.mjs"
  ],
  "exclude": [
    "google-maps-mcp-server/**/*",
    "scripts/generate-schema.ts",
    "CleaningChecklist.astro"
  ]
}
