---
import Icon from './Icon.astro';
// Review Platform Badges Section
---

<section class="py-12 px-6 bg-gradient-to-r from-gray-50 to-gray-100">
  <div class="container mx-auto">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-bold mb-2 text-[#333333]">Verified Reviews You Can Check Yourself</h2>
      <p class="text-gray-600">Every rating below links straight to the source — read them for yourself</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-4xl mx-auto">
      <!-- Google Reviews -->
      <a href="https://g.page/r/thevalleycleanteam/review" target="_blank" rel="noopener noreferrer" class="bg-white rounded-xl p-6 shadow-md border border-gray-200 hover:shadow-lg hover:border-[#FFA985] transition text-center group">
        <div class="w-12 h-12 mx-auto mb-3 flex items-center justify-center">
          <Icon name="google" class="w-10 h-10 text-[#4285F4] group-hover:scale-110 transition" />
        </div>
        <div class="flex justify-center text-yellow-400 text-sm mb-2">
          <Icon name="star" class="w-4 h-4" fill="currentColor" />
          <Icon name="star" class="w-4 h-4" fill="currentColor" />
          <Icon name="star" class="w-4 h-4" fill="currentColor" />
          <Icon name="star" class="w-4 h-4" fill="currentColor" />
          <Icon name="star" class="w-4 h-4" fill="currentColor" />
        </div>
        <p class="font-bold text-[#333333]">4.9 Rating</p>
        <p class="text-sm text-gray-500">148 Reviews</p>
        <p class="text-xs text-[#FFA985] mt-2">Google Business</p>
      </a>

      <!-- Facebook Reviews -->
      <a href="https://facebook.com/thevalleycleanteam" target="_blank" rel="noopener noreferrer" class="bg-white rounded-xl p-6 shadow-md border border-gray-200 hover:shadow-lg hover:border-[#FFA985] transition text-center group">
        <div class="w-12 h-12 mx-auto mb-3 flex items-center justify-center">
          <Icon name="facebook" class="w-10 h-10 text-[#1877F2] group-hover:scale-110 transition" />
        </div>
        <div class="flex justify-center text-yellow-400 text-sm mb-2">
          <Icon name="star" class="w-4 h-4" fill="currentColor" />
          <Icon name="star" class="w-4 h-4" fill="currentColor" />
          <Icon name="star" class="w-4 h-4" fill="currentColor" />
          <Icon name="star" class="w-4 h-4" fill="currentColor" />
          <Icon name="star" class="w-4 h-4" fill="currentColor" />
        </div>
        <p class="font-bold text-[#333333]">4.9 Rating</p>
        <p class="text-sm text-gray-500">50+ Reviews</p>
        <p class="text-xs text-[#FFA985] mt-2">Facebook</p>
      </a>

      {/*
        Thumbtack restored as a real link — profile verified at 4.9 from 27
        reviews with an active Top Pro badge, which matches what we claim.

        Yelp deliberately NOT shown: the live profile is 2.7 from 3 reviews,
        not the "4.9 / 25+ reviews" this section used to display. Do not
        re-add a Yelp rating badge unless the profile itself improves.
      */}
      <a href="https://www.thumbtack.com/al/tuscumbia/house-cleaning/valley-clean-team/service/468267903327502342" target="_blank" rel="noopener noreferrer" class="bg-white rounded-xl p-6 shadow-md border border-gray-200 hover:shadow-lg hover:border-[#FFA985] transition text-center group">
        <div class="w-12 h-12 mx-auto mb-3 flex items-center justify-center">
          <Icon name="home" class="w-10 h-10 text-[#FF6B35]" />
        </div>
        <div class="flex justify-center text-yellow-400 text-sm mb-2">
          <Icon name="star" class="w-4 h-4" fill="currentColor" />
          <Icon name="star" class="w-4 h-4" fill="currentColor" />
          <Icon name="star" class="w-4 h-4" fill="currentColor" />
          <Icon name="star" class="w-4 h-4" fill="currentColor" />
          <Icon name="star" class="w-4 h-4" fill="currentColor" />
        </div>
        <p class="font-bold text-[#333333]">4.9 Rating</p>
        <p class="text-sm text-gray-500">27 Reviews · Top Pro</p>
        <p class="text-xs text-[#FFA985] mt-2">Thumbtack</p>
      </a>
    </div>

    <!-- Summary Stats -->
    <div class="mt-12 bg-white rounded-2xl p-8 shadow-lg max-w-3xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <p class="text-4xl font-bold text-[#FFA985]">148</p>
          <p class="text-gray-600 text-sm">Google Reviews</p>
        </div>
        <div>
          <p class="text-4xl font-bold text-[#FFA985]">4.9</p>
          <p class="text-gray-600 text-sm">Average Rating</p>
        </div>
        <div>
          <p class="text-4xl font-bold text-[#FFA985]">$2M</p>
          <p class="text-gray-600 text-sm">Liability Insured</p>
        </div>
        <div>
          <p class="text-4xl font-bold text-[#FFA985]">24hr</p>
          <p class="text-gray-600 text-sm">Re-Clean Guarantee</p>
        </div>
      </div>
    </div>
  </div>
</section>
