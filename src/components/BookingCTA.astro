---
import Icon from "./Icon.astro";
import { PERFORMANCE, REVIEWS } from "../data/claims";
import { MARKET_PHONES } from "../constants/schemaData";

interface Props {
  city?: string;
  state?: string;
  serviceName?: string;
  variant?: "card" | "embedded" | "compact";
  heading?: string;
  subheading?: string;
}

const {
  city = "",
  state = "AL",
  serviceName = "",
  variant = "embedded",
  heading,
  subheading,
} = Astro.props;

const ctaPhone = state === "TN" ? MARKET_PHONES.TN : MARKET_PHONES.AL;
const displayCity = city || "Your Area";
const displayService = serviceName || "Cleaning Service";

const defaultHeading = heading
  ? heading
  : city
    ? `Call for Your Exact ${city} Price`
    : "Call for Your Exact Price";

const defaultSubheading = subheading
  ? subheading
  : serviceName && city
    ? `${displayService} in ${displayCity} — quoted in minutes on a quick call, zero obligation`
    : city
      ? `Serving all ${displayCity} neighborhoods`
      : "Quoted in minutes on a quick call. Zero obligation, and your price is confirmed in writing before we start.";
---

<div
  class:list={[
    "booking-cta-component",
    variant === "card"
      ? "bg-white rounded-2xl shadow-xl border border-gray-100/50 p-6 md:p-8"
      : variant === "compact"
        ? "text-center"
        : "rounded-xl",
  ]}
>
  <div class="text-center mb-6">
    <h3 class="text-2xl font-bold text-[#333333] mb-2">{defaultHeading}</h3>
    <p class="text-gray-500 text-sm">{defaultSubheading}</p>
  </div>

  <div class="flex flex-wrap justify-center gap-3 mb-6 text-xs text-gray-600">
    <span class="flex items-center gap-1">
      <Icon name="shield-alt" class="w-3.5 h-3.5 text-green-500" />
      Insured &amp; Bonded
    </span>
    <span class="flex items-center gap-1">
      <Icon name="star" class="w-3.5 h-3.5 text-[#FFA985]" fill="currentColor" />
      {REVIEWS.rating}★ from {REVIEWS.countDisplay} Reviews
    </span>
    <span class="flex items-center gap-1">
      <Icon name="clock" class="w-3.5 h-3.5 text-blue-500" />
      Reply within {PERFORMANCE.quoteResponseSla}
    </span>
  </div>

  <a
    href={ctaPhone.href}
    class="block w-full py-4 px-6 rounded-xl bg-gradient-to-r from-[#FFA985] to-[#FFC67D] text-[#333333] font-bold text-center text-lg shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 group"
    onclick="if(typeof gtag==='function'){gtag('event','cta_click',{event_category:'CTA',event_label:'BookingCTA - Call for a Free Quote',page_location:window.location.href});}"
  >
    <Icon name="phone" class="w-5 h-5 inline mr-2 group-hover:scale-110 transition-transform" />
    Call for a Free Quote — {ctaPhone.display}
  </a>

  <div class="mt-4 text-center">
    <p class="text-xs text-gray-400 mb-2">Both service areas:</p>
    <div class="flex flex-col sm:flex-row justify-center gap-2">
      <a
        href={MARKET_PHONES.AL.href}
        class="inline-flex items-center justify-center text-sm font-semibold text-gray-700 hover:text-[#FFA985] transition"
      >
        <Icon name="phone" class="w-4 h-4 mr-1 text-[#FFA985]" />
        AL: {MARKET_PHONES.AL.display}
      </a>
      <span class="hidden sm:inline text-gray-300">|</span>
      <a
        href={MARKET_PHONES.TN.href}
        class="inline-flex items-center justify-center text-sm font-semibold text-gray-700 hover:text-[#FFA985] transition"
      >
        <Icon name="phone" class="w-4 h-4 mr-1 text-[#FFA985]" />
        TN: {MARKET_PHONES.TN.display}
      </a>
    </div>
  </div>
</div>
