---
import Icon from './Icon.astro';
import { IDENTITY, PERFORMANCE, REVIEWS } from '../data/claims';

interface Props {
  variant?: 'full' | 'compact' | 'inline' | 'section';
  /** Retained for call-site compatibility; guarantee copy is intentionally retired. */
  showGuarantee?: boolean;
}

const { variant = 'full' } = Astro.props;
const reviewSummary = `${REVIEWS.rating}★ across ${REVIEWS.countDisplay} Google reviews`;
---

{variant === 'section' && (
  <section class="py-16 px-6 bg-white">
    <div class="container mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4 text-[#333333]">Why Families Choose The Valley Clean Team</h2>
        <div class="section-divider"></div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6 text-center mb-12">
        <div class="trust-badge">
          <div class="w-16 h-16 mx-auto rounded-full bg-gradient-to-br from-[#FFA985] to-[#FFC67D] flex items-center justify-center mb-3">
            <Icon name="medal" class="w-6 h-6 text-white" />
          </div>
          <h4 class="font-bold text-[#333333] text-sm mb-1">Veteran Owned</h4>
          <p class="text-xs text-gray-600">Verified ownership</p>
        </div>

        <div class="trust-badge">
          <div class="w-16 h-16 mx-auto rounded-full bg-gradient-to-br from-[#FFA985] to-[#FFC67D] flex items-center justify-center mb-3">
            <Icon name="user-check" class="w-6 h-6 text-white" />
          </div>
          <h4 class="font-bold text-[#333333] text-sm mb-1">Woman Owned</h4>
          <p class="text-xs text-gray-600">Verified ownership</p>
        </div>

        <div class="trust-badge">
          <div class="w-16 h-16 mx-auto rounded-full bg-gradient-to-br from-[#FFA985] to-[#FFC67D] flex items-center justify-center mb-3">
            <Icon name="home" class="w-6 h-6 text-white" />
          </div>
          <h4 class="font-bold text-[#333333] text-sm mb-1">Family Owned</h4>
          <p class="text-xs text-gray-600">Locally operated</p>
        </div>

        <div class="trust-badge">
          <div class="w-16 h-16 mx-auto rounded-full bg-gradient-to-br from-[#FFA985] to-[#FFC67D] flex items-center justify-center mb-3">
            <Icon name="calendar-check" class="w-6 h-6 text-white" />
          </div>
          <h4 class="font-bold text-[#333333] text-sm mb-1">{PERFORMANCE.avgCleanerExperienceYears} Years Avg.</h4>
          <p class="text-xs text-gray-600">Cleaner experience</p>
        </div>

        <div class="trust-badge">
          <div class="w-16 h-16 mx-auto rounded-full bg-gradient-to-br from-[#FFA985] to-[#FFC67D] flex items-center justify-center mb-3">
            <Icon name="star" class="w-6 h-6 text-white" />
          </div>
          <h4 class="font-bold text-[#333333] text-sm mb-1">{REVIEWS.rating}★ Rating</h4>
          <p class="text-xs text-gray-600">{REVIEWS.countDisplay} Google reviews</p>
        </div>

        <div class="trust-badge">
          <div class="w-16 h-16 mx-auto rounded-full bg-gradient-to-br from-[#FFA985] to-[#FFC67D] flex items-center justify-center mb-3">
            <Icon name="clock" class="w-6 h-6 text-white" />
          </div>
          <h4 class="font-bold text-[#333333] text-sm mb-1">{PERFORMANCE.quoteResponseSla}</h4>
          <p class="text-xs text-gray-600">Quote response SLA</p>
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
          <h3 class="font-bold text-[#333333] mb-4 flex items-center">
            <Icon name="users" class="w-5 h-5 text-[#FFA985] mr-2" />
            Ownership
          </h3>
          <ul class="space-y-2 text-sm text-gray-600">
            <li><Icon name="check" class="w-4 h-4 text-green-500 mr-2 inline" />{IDENTITY.primaryPhraseCapitalized}</li>
            <li><Icon name="check" class="w-4 h-4 text-green-500 mr-2 inline" />Family owned</li>
            <li><Icon name="check" class="w-4 h-4 text-green-500 mr-2 inline" />Serving customers across Alabama and Tennessee</li>
          </ul>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
          <h3 class="font-bold text-[#333333] mb-4 flex items-center">
            <Icon name="chart-line" class="w-5 h-5 text-[#FFA985] mr-2" />
            Experience & Performance
          </h3>
          <ul class="space-y-2 text-sm text-gray-600">
            <li><Icon name="check" class="w-4 h-4 text-green-500 mr-2 inline" />{PERFORMANCE.avgCleanerExperienceYears} years average cleaner experience</li>
            <li><Icon name="check" class="w-4 h-4 text-green-500 mr-2 inline" />{PERFORMANCE.onTimeArrivalPct}% on-time arrival rate</li>
            <li><Icon name="check" class="w-4 h-4 text-green-500 mr-2 inline" />{PERFORMANCE.repeatCustomerPct}% repeat-customer rate</li>
          </ul>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
          <h3 class="font-bold text-[#333333] mb-4 flex items-center">
            <Icon name="star" class="w-5 h-5 text-[#FFA985] mr-2" />
            Customer Proof
          </h3>
          <ul class="space-y-2 text-sm text-gray-600">
            <li><Icon name="check" class="w-4 h-4 text-green-500 mr-2 inline" />{reviewSummary}</li>
            <li><Icon name="check" class="w-4 h-4 text-green-500 mr-2 inline" />{PERFORMANCE.customersServedDisplay} customers served</li>
            <li><Icon name="check" class="w-4 h-4 text-green-500 mr-2 inline" />Quote requests answered within {PERFORMANCE.quoteResponseSla}</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
)}

{variant === 'full' && (
  <div class="trust-badges py-6 px-4 bg-white rounded-2xl border border-gray-200 shadow-sm">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div class="trust-badge">
        <div class="w-14 h-14 mx-auto rounded-full bg-gradient-to-br from-[#FFA985] to-[#FFC67D] flex items-center justify-center mb-3">
          <Icon name="medal" class="w-5 h-5 text-white" />
        </div>
        <h4 class="font-bold text-[#333333] text-sm mb-1">Veteran & Woman Owned</h4>
        <p class="text-xs text-gray-600">Family owned</p>
      </div>

      <div class="trust-badge">
        <div class="w-14 h-14 mx-auto rounded-full bg-gradient-to-br from-[#FFA985] to-[#FFC67D] flex items-center justify-center mb-3">
          <Icon name="calendar-check" class="w-5 h-5 text-white" />
        </div>
        <h4 class="font-bold text-[#333333] text-sm mb-1">{PERFORMANCE.avgCleanerExperienceYears} Years Avg.</h4>
        <p class="text-xs text-gray-600">Cleaner experience</p>
      </div>

      <div class="trust-badge">
        <div class="w-14 h-14 mx-auto rounded-full bg-gradient-to-br from-[#FFA985] to-[#FFC67D] flex items-center justify-center mb-3">
          <Icon name="star" class="w-5 h-5 text-white" />
        </div>
        <h4 class="font-bold text-[#333333] text-sm mb-1">{REVIEWS.rating}★ Google Rating</h4>
        <p class="text-xs text-gray-600">{REVIEWS.countDisplay} reviews</p>
      </div>

      <div class="trust-badge">
        <div class="w-14 h-14 mx-auto rounded-full bg-gradient-to-br from-[#FFA985] to-[#FFC67D] flex items-center justify-center mb-3">
          <Icon name="users" class="w-5 h-5 text-white" />
        </div>
        <h4 class="font-bold text-[#333333] text-sm mb-1">{PERFORMANCE.customersServedDisplay} Customers</h4>
        <p class="text-xs text-gray-600">Served</p>
      </div>
    </div>

    <div class="mt-6 pt-6 border-t border-gray-200 text-center">
      <p class="text-gray-700 font-medium">
        <Icon name="clock" class="w-5 h-5 text-[#FFA985] mr-2 inline" />
        Quote requests answered within <span class="text-[#333333] font-bold">{PERFORMANCE.quoteResponseSla}</span>.
      </p>
    </div>
  </div>
)}

{variant === 'compact' && (
  <div class="trust-badges-compact flex flex-wrap justify-center gap-4 py-4">
    <div class="flex items-center bg-gray-50 px-4 py-2 rounded-full">
      <Icon name="medal" class="w-4 h-4 text-[#FFA985] mr-2" />
      <span class="text-sm font-medium text-[#333333]">Veteran & Woman Owned</span>
    </div>
    <div class="flex items-center bg-gray-50 px-4 py-2 rounded-full">
      <Icon name="home" class="w-4 h-4 text-[#FFA985] mr-2" />
      <span class="text-sm font-medium text-[#333333]">Family Owned</span>
    </div>
    <div class="flex items-center bg-gray-50 px-4 py-2 rounded-full">
      <Icon name="star" class="w-4 h-4 text-[#FFA985] mr-2" />
      <span class="text-sm font-medium text-[#333333]">{REVIEWS.rating}★ · {REVIEWS.countDisplay} Reviews</span>
    </div>
    <div class="flex items-center bg-gray-50 px-4 py-2 rounded-full">
      <Icon name="clock" class="w-4 h-4 text-[#FFA985] mr-2" />
      <span class="text-sm font-medium text-[#333333]">{PERFORMANCE.quoteResponseSla} Quotes</span>
    </div>
  </div>
)}

{variant === 'inline' && (
  <div class="trust-badges-inline flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-gray-600">
    <span><Icon name="medal" class="w-4 h-4 text-[#FFA985] mr-1 inline" /> Veteran & Woman Owned</span>
    <span><Icon name="home" class="w-4 h-4 text-[#FFA985] mr-1 inline" /> Family Owned</span>
    <span><Icon name="star" class="w-4 h-4 text-[#FFA985] mr-1 inline" /> {REVIEWS.rating}★ · {REVIEWS.countDisplay} Reviews</span>
    <span><Icon name="calendar-check" class="w-4 h-4 text-[#FFA985] mr-1 inline" /> {PERFORMANCE.avgCleanerExperienceYears} Years Avg. Experience</span>
  </div>
)}
