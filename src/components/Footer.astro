---
import Icon from "./Icon.astro";
import { IDENTITY, PERFORMANCE, REVIEWS, TRUST } from "../data/claims";
---

<style>
  footer ul li > a,
  footer ul li > a:visited {
    display: inline-block;
    padding: 6px 0;
    line-height: 1.25;
  }
</style>

<section class="py-8 px-6 bg-gradient-to-r from-[#333333] to-[#444444] text-white">
  <div class="container mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-6 text-center text-sm">
      {TRUST.isInsured && (
        <div>
          <Icon name="shield-alt" class="w-5 h-5 text-[#FFA985] mb-2" />
          <p class="font-semibold">Insured</p>
          <p class="text-gray-300 text-xs">Business coverage</p>
        </div>
      )}
      {TRUST.backgroundChecks && (
        <div>
          <Icon name="user-check" class="w-5 h-5 text-[#FFA985] mb-2" />
          <p class="font-semibold">Background Checked</p>
          <p class="text-gray-300 text-xs">Cleaner screening</p>
        </div>
      )}
      {TRUST.satisfactionGuarantee && TRUST.freeReclean && (
        <div>
          <Icon name="redo" class="w-5 h-5 text-[#FFA985] mb-2" />
          <p class="font-semibold">100% Satisfaction</p>
          <p class="text-gray-300 text-xs">Free re-clean if needed</p>
        </div>
      )}
      {TRUST.weekendAvailability && (
        <div>
          <Icon name="calendar" class="w-5 h-5 text-[#FFA985] mb-2" />
          <p class="font-semibold">Weekends Available</p>
          <p class="text-gray-300 text-xs">Check current openings</p>
        </div>
      )}
      <div>
        <Icon name="calendar-check" class="w-5 h-5 text-[#FFA985] mb-2" />
        <p class="font-semibold">{PERFORMANCE.avgCleanerExperienceYears} Years Avg.</p>
        <p class="text-gray-300 text-xs">Cleaner experience</p>
      </div>
      <div>
        <Icon name="users" class="w-5 h-5 text-[#FFA985] mb-2" />
        <p class="font-semibold">{PERFORMANCE.customersServedDisplay}</p>
        <p class="text-gray-300 text-xs">Customers served</p>
      </div>
      <div>
        <Icon name="star" class="w-5 h-5 text-[#FFA985] mb-2" />
        <p class="font-semibold">{REVIEWS.rating}★ · {REVIEWS.countDisplay}</p>
        <p class="text-gray-300 text-xs">Google reviews</p>
      </div>
      <div>
        <Icon name="clock" class="w-5 h-5 text-[#FFA985] mb-2" />
        <p class="font-semibold">{PERFORMANCE.quoteResponseSla}</p>
        <p class="text-gray-300 text-xs">Quote response SLA</p>
      </div>
    </div>
  </div>
</section>

<footer class="py-12 px-6 border-t border-gray-200 bg-gray-50">
  <div class="container mx-auto">
    <div class="grid md:grid-cols-2 lg:grid-cols-6 gap-8 mb-8">
      <div>
        <div class="mb-4">
          <a href="/" class="inline-block">
            <picture>
              <source srcset="/images/logo.webp" type="image/webp" />
              <img src="/images/logo.png" alt="The Valley Clean Team" class="h-12 w-auto object-contain" width="332" height="95" loading="lazy" />
            </picture>
          </a>
        </div>
        <p class="text-gray-600 mb-3">Thorough, dependable cleaning for homes and offices.</p>
        <p class="text-gray-500 text-xs">
          {IDENTITY.primaryPhraseCapitalized}, family owned, insured, with background-checked cleaners and a 100% satisfaction guarantee with free re-cleaning. Weekend appointments are available; check BookingKoala for current openings.
        </p>
      </div>

      <div>
        <h4 class="font-bold mb-4 text-[#333333]">Services</h4>
        <ul class="space-y-2 text-gray-600">
          <li><a href="/services" class="hover:text-[#FFA985] transition">All Services</a></li>
          <li><a href="/services/house-cleaning" class="hover:text-[#FFA985] transition">House Cleaning</a></li>
          <li><a href="/services/maid-service" class="hover:text-[#FFA985] transition">Maid Service</a></li>
          <li><a href="/services/deep-cleaning" class="hover:text-[#FFA985] transition">Deep Cleaning</a></li>
          <li><a href="/services/regular-cleaning" class="hover:text-[#FFA985] transition">Regular Cleaning</a></li>
          <li><a href="/services/move-in-out-cleaning" class="hover:text-[#FFA985] transition">Move In/Out</a></li>
          <li><a href="/services/commercial-cleaning" class="hover:text-[#FFA985] transition">Commercial Cleaning</a></li>
          <li><a href="/pricing" class="hover:text-[#FFA985] transition">Pricing</a></li>
          <li><a href="tel:2568261100" class="hover:text-[#FFA985] transition font-semibold">Get your price →</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold mb-4 text-[#333333]">Specialized Cleaning</h4>
        <ul class="space-y-2 text-gray-600 text-sm">
          <li><a href="/medical-clinic-cleaning" class="hover:text-[#FFA985] transition">Medical Clinic Cleaning</a></li>
          <li><a href="/dialysis-center-cleaning" class="hover:text-[#FFA985] transition">Dialysis Center Cleaning</a></li>
          <li><a href="/dental-office-cleaning" class="hover:text-[#FFA985] transition">Dental Office Cleaning</a></li>
          <li><a href="/church-cleaning" class="hover:text-[#FFA985] transition">Church Cleaning</a></li>
          <li><a href="/services/compassionate-clean" class="hover:text-[#FFA985] transition">Compassionate Clean</a></li>
          <li><a href="/luxury-homes" class="hover:text-[#FFA985] transition">Luxury Home Cleaning</a></li>
          <li class="pt-2"><a href="https://thevalleycleanteam.bookingkoala.com/booknow/office_cleaning" class="hover:text-[#FFA985] transition font-semibold text-[#FFA985]">Commercial Quote →</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold mb-4 text-[#333333]">Blog & Resources</h4>
        <ul class="space-y-2 text-gray-600 text-sm">
          <li><a href="/blog" class="hover:text-[#FFA985] transition">All Articles</a></li>
          <li><a href="/blog/deep-cleaning-cost-shoals-guide" class="hover:text-[#FFA985] transition">Deep Cleaning Cost Guide</a></li>
          <li><a href="/blog/move-out-cleaning-huntsville-guide" class="hover:text-[#FFA985] transition">Move-Out Cleaning Guide</a></li>
          <li><a href="/blog/airbnb-cleaning-nashville-host-guide" class="hover:text-[#FFA985] transition">Airbnb Cleaning Nashville</a></li>
          <li><a href="/blog/3-red-flags-hiring-cleaning-service" class="hover:text-[#FFA985] transition">3 Red Flags to Watch For</a></li>
          <li><a href="/blog/is-hiring-house-cleaner-worth-it" class="hover:text-[#FFA985] transition">Is a House Cleaner Worth It?</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold mb-4 text-[#333333]">Service Areas</h4>
        <div class="grid grid-cols-2 gap-4">
          <ul class="space-y-1 text-gray-600 text-sm">
            <li class="font-bold text-gray-800 text-xs uppercase tracking-wider mb-1">Alabama</li>
            <li><a href="/locations/huntsville" class="hover:text-[#FFA985] transition">Huntsville</a></li>
            <li><a href="/locations/madison" class="hover:text-[#FFA985] transition">Madison</a></li>
            <li><a href="/locations/athens" class="hover:text-[#FFA985] transition">Athens</a></li>
            <li><a href="/locations/decatur" class="hover:text-[#FFA985] transition">Decatur</a></li>
            <li><a href="/locations/florence" class="hover:text-[#FFA985] transition">Florence</a></li>
            <li><a href="/locations/muscle-shoals" class="hover:text-[#FFA985] transition">Muscle Shoals</a></li>
            <li><a href="/locations/mountain-brook" class="hover:text-[#FFA985] transition">Mountain Brook</a></li>
          </ul>
          <ul class="space-y-1 text-gray-600 text-sm">
            <li class="font-bold text-gray-800 text-xs uppercase tracking-wider mb-1">Tennessee</li>
            <li><a href="/locations/nashville" class="hover:text-[#FFA985] transition">Nashville</a></li>
            <li><a href="/locations/west-nashville" class="hover:text-[#FFA985] transition">West Nashville</a></li>
            <li class="pt-2"><a href="/locations" class="hover:text-[#FFA985] transition font-semibold">All locations →</a></li>
          </ul>
        </div>
      </div>

      <div>
        <h4 class="font-bold mb-4 text-[#333333]">Contact</h4>
        <ul class="space-y-2 text-gray-600">
          <li><a href="tel:2568261100" class="hover:text-[#FFA985] transition"><Icon name="phone" class="w-4 h-4 text-[#FFA985] inline" /> AL: 256-826-1100</a></li>
          <li><a href="tel:6155101427" class="hover:text-[#FFA985] transition"><Icon name="phone" class="w-4 h-4 text-[#FFA985] inline" /> TN: 615-510-1427</a></li>
          <li><a href="mailto:hello@thevalleycleanteam.com" class="hover:text-[#FFA985] transition break-all"><Icon name="envelope" class="w-4 h-4 text-[#FFA985] inline" /> hello@thevalleycleanteam.com</a></li>
          <li class="mt-4 pt-4 border-t border-gray-200"><a href="https://thevalleycleanteam.bookingkoala.com/hiring/form/careers" class="hover:text-[#FFA985] transition font-bold flex items-center text-[#333333]"><Icon name="users" class="w-4 h-4 text-[#FFA985] inline mr-2" />Careers</a></li>
          <li><a href="/trust" class="hover:text-[#FFA985] transition font-bold flex items-center text-[#333333]"><Icon name="star" class="w-4 h-4 text-[#FFA985] inline mr-2" />Customer Reviews & Trust</a></li>
        </ul>

        <div class="flex items-center gap-3 mt-4">
          <a href="https://www.facebook.com/thevalleycleanteam/" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-gray-200 hover:bg-[#FFA985] flex items-center justify-center transition" aria-label="Facebook"><Icon name="facebook" class="w-5 h-5 text-gray-600" /></a>
          <a href="https://www.instagram.com/thevalleycleanteamal/" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-gray-200 hover:bg-[#FFA985] flex items-center justify-center transition" aria-label="Instagram"><Icon name="instagram" class="w-5 h-5 text-gray-600" /></a>
          <a href="https://www.linkedin.com/company/thevalleycleanteam" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-gray-200 hover:bg-[#FFA985] flex items-center justify-center transition" aria-label="LinkedIn"><Icon name="briefcase" class="w-5 h-5 text-gray-600" /></a>
          <a href="https://www.google.com/maps?cid=2354162289321042477" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-gray-200 hover:bg-[#FFA985] flex items-center justify-center transition" aria-label="Google Reviews"><Icon name="star" class="w-5 h-5 text-gray-600" /></a>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-200 pt-8 mt-8">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-600">
        <p>
          &copy; {new Date().getFullYear()} The Valley Clean Team. All rights reserved.
          <span class="mx-2 text-gray-400">|</span>
          <a href="/privacy" class="hover:text-[#FFA985] transition underline underline-offset-4 decoration-gray-300">Privacy Policy</a>
          <span class="mx-2 text-gray-400">|</span>
          <a href="/terms" class="hover:text-[#FFA985] transition underline underline-offset-4 decoration-gray-300">Terms of Service</a>
        </p>
        <div class="flex flex-wrap justify-center gap-4 text-xs">
          {TRUST.isInsured && <span><Icon name="shield-alt" class="w-4 h-4 text-[#FFA985] mr-1 inline" />Insured</span>}
          {TRUST.backgroundChecks && <span><Icon name="user-check" class="w-4 h-4 text-[#FFA985] mr-1 inline" />Background Checked</span>}
          {TRUST.satisfactionGuarantee && TRUST.freeReclean && <span><Icon name="redo" class="w-4 h-4 text-[#FFA985] mr-1 inline" />Re-Clean Within {TRUST.recleanWindowHours} Hours</span>}
          {TRUST.weekendAvailability && <span><Icon name="calendar" class="w-4 h-4 text-[#FFA985] mr-1 inline" />Weekends Available</span>}
        </div>
      </div>
    </div>
  </div>
</footer>
