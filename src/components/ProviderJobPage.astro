---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "./Icon.astro";
import type { ProviderJob } from "../data/providerJobs";

interface Props {
  job: ProviderJob;
}

const { job } = Astro.props;
const stateName = job.region === "AL" ? "Alabama" : "Tennessee";
const canonicalUrl = `https://thevalleycleanteam.com/careers/${job.slug}`;
const applicationUrl =
  "https://thevalleycleanteam.bookingkoala.com/hiring/form/careers" +
  `?utm_source=tvct_website&utm_medium=organic&utm_campaign=provider_recruiting&utm_content=${job.slug}`;
const postedDate = "2026-08-14";
const displayPostedDate = "August 14, 2026";

const qualifications = [
  "Professional residential-cleaning experience",
  "Reliable transportation and a smartphone",
  "Your own professional cleaning supplies and working equipment",
  "Clear, prompt communication and strong attention to detail",
  "The ability to manage your service area and availability accurately",
  "Appropriate general liability insurance, or the ability to obtain it before regular assignments",
];

const jobDescription = `
  <p>${job.introduction}</p>
  <p>This contractor opportunity is for an experienced independent cleaner or small cleaning business that wants access to additional residential cleaning jobs while retaining control of its own availability and service area.</p>
  <p><strong>Compensation:</strong> Typical earning equivalent is $25–$45 per hour, based on experience, job scope, completion time, and provider efficiency. Providers receive flat-rate pay per completed job, with the job scope and provider pay shown before acceptance. Jobs and earnings are not guaranteed.</p>
  <p><strong>Responsibilities:</strong> Complete accepted residential cleaning assignments professionally; provide your own transportation, supplies, and equipment; communicate promptly; document work with before-and-after photos when required; and verify completion of the agreed scope.</p>
  <p><strong>Qualifications:</strong> Professional residential-cleaning experience, reliable transportation, smartphone access, professional supplies and equipment, strong communication, attention to detail, and the ability to complete screening and onboarding. No specific education credential is required.</p>
  <p><strong>Schedule:</strong> Independent providers manage their own availability and decide whether an available assignment fits their business. This is not a remote position.</p>
  <p>Qualified applicants complete a short application, an initial screening, a video interview, and a paid test clean.</p>
`;

const jobSchema = {
  "@context": "https://schema.org",
  "@type": "JobPosting",
  title: "Independent Residential Cleaning Provider",
  description: jobDescription,
  identifier: {
    "@type": "PropertyValue",
    name: "The Valley Clean Team",
    value: job.identifier,
  },
  datePosted: postedDate,
  directApply: true,
  employmentType: "CONTRACTOR",
  hiringOrganization: {
    "@type": "Organization",
    name: "The Valley Clean Team",
    sameAs: "https://thevalleycleanteam.com",
    logo: "https://thevalleycleanteam.com/images/logo.webp",
  },
  jobLocation: {
    "@type": "Place",
    address: {
      "@type": "PostalAddress",
      addressLocality: job.locality,
      addressRegion: job.region,
      addressCountry: "US",
    },
  },
  industry: "Residential cleaning services",
  occupationalCategory: "37-2012.00 Maids and Housekeeping Cleaners",
  responsibilities:
    "Complete accepted residential cleaning assignments professionally, provide your own transportation and equipment, communicate promptly, document work when required, and verify the agreed scope.",
  qualifications:
    "Professional residential-cleaning experience, reliable transportation, smartphone access, professional supplies and equipment, communication skills, attention to detail, and completion of screening and onboarding.",
  experienceRequirements: "Professional residential-cleaning experience required.",
  educationRequirements: "No specific education credential required.",
  url: canonicalUrl,
};

const processSteps = [
  {
    title: "Apply online",
    copy: "Tell us about your cleaning experience, service area, equipment, and availability.",
  },
  {
    title: "Complete two conversations",
    copy: "Qualified applicants move through a short screening call and a video interview.",
  },
  {
    title: "Complete a paid test clean",
    copy: "Show us your cleaning process, communication, attention to detail, and customer care.",
  },
  {
    title: "Finish provider onboarding",
    copy: "Approved providers complete the agreement, screening, insurance, tax, app, and payment steps.",
  },
];
---

<BaseLayout
  title={`Independent Cleaning Provider — ${job.market}, ${job.region}`}
  description={`Independent residential cleaning provider opportunity in ${job.market}, ${stateName}. Typical earning equivalent $25–$45 per hour. Apply online.`}
  canonicalUrl={canonicalUrl}
  geoRegion={job.geoRegion}
  geoPlacename={`${job.locality}, ${stateName}`}
  geoPosition={job.geoPosition}
  schemaType="none"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jobSchema)} />

  <main>
    <section class="relative overflow-hidden pt-32 pb-20 px-6 bg-gradient-to-br from-white via-[#fff8f4] to-[#fff0e8]">
      <div class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-[#FFA985]/15 blur-3xl" aria-hidden="true"></div>
      <div class="container mx-auto max-w-6xl relative z-10">
        <div class="max-w-4xl">
          <p class="inline-flex items-center gap-2 rounded-full bg-white border border-[#FFA985]/30 px-4 py-2 text-sm font-semibold text-[#7a3f2a] shadow-sm mb-6">
            <Icon name="briefcase" class="w-4 h-4" />
            Independent contractor opportunity
          </p>
          <h1 class="text-4xl md:text-6xl font-bold text-[#333333] mb-6 leading-tight">
            Independent Cleaning Provider in <span class="gold-gradient">{job.market}</span>
          </h1>
          <p class="text-xl md:text-2xl text-gray-700 leading-relaxed max-w-3xl mb-8">
            {job.introduction} Add residential cleaning opportunities to your business while managing your own availability and service area.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center">
            <a
              href={applicationUrl}
              class="inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#FFA985] to-[#FFC67D] px-8 py-4 text-lg font-bold text-[#333333] shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all"
            >
              Apply to Become a Provider
              <Icon name="arrow-right" class="w-5 h-5" />
            </a>
            <a href="mailto:careers@thevalleycleanteam.com" class="font-semibold text-gray-700 hover:text-[#b85835] transition">
              Questions? careers@thevalleycleanteam.com
            </a>
          </div>
          <p class="mt-5 text-sm text-gray-500">Posted {displayPostedDate} · Applications are currently open</p>
        </div>
      </div>
    </section>

    <section class="px-6 -mt-8 relative z-20">
      <div class="container mx-auto max-w-6xl grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="rounded-2xl bg-white p-6 shadow-lg border border-gray-100">
          <Icon name="dollar-sign" class="w-7 h-7 text-[#d26c45] mb-3" />
          <p class="text-sm text-gray-500">Typical earning equivalent</p>
          <p class="text-xl font-bold text-[#333333]">$25–$45/hour</p>
        </div>
        <div class="rounded-2xl bg-white p-6 shadow-lg border border-gray-100">
          <Icon name="briefcase" class="w-7 h-7 text-[#d26c45] mb-3" />
          <p class="text-sm text-gray-500">Opportunity type</p>
          <p class="text-xl font-bold text-[#333333]">Independent provider</p>
        </div>
        <div class="rounded-2xl bg-white p-6 shadow-lg border border-gray-100">
          <Icon name="map-marker-alt" class="w-7 h-7 text-[#d26c45] mb-3" />
          <p class="text-sm text-gray-500">Primary market</p>
          <p class="text-xl font-bold text-[#333333]">{job.market}, {job.region}</p>
        </div>
        <div class="rounded-2xl bg-white p-6 shadow-lg border border-gray-100">
          <Icon name="calendar-check" class="w-7 h-7 text-[#d26c45] mb-3" />
          <p class="text-sm text-gray-500">Qualification step</p>
          <p class="text-xl font-bold text-[#333333]">Paid test clean</p>
        </div>
      </div>
    </section>

    <section class="py-20 px-6 bg-white">
      <div class="container mx-auto max-w-6xl grid lg:grid-cols-[1.15fr_0.85fr] gap-14 items-start">
        <div>
          <p class="text-sm uppercase tracking-[0.18em] text-[#b85835] font-bold mb-3">The opportunity</p>
          <h2 class="text-3xl md:text-4xl font-bold text-[#333333] mb-6">Add jobs without giving up control of your business</h2>
          <p class="text-lg text-gray-700 leading-relaxed mb-8">
            This opportunity is designed for an experienced solo cleaner or small cleaning business. Available jobs are matched to your stated service area and availability. You review the scope and flat-rate provider pay before deciding whether to accept.
          </p>
          <div class="rounded-2xl bg-[#fff8f4] border border-[#FFA985]/25 p-6 mb-8">
            <h3 class="text-xl font-bold text-[#333333] mb-3">How compensation works</h3>
            <p class="text-gray-700 leading-relaxed">
              Typical earning equivalent is <strong>$25–$45 per hour</strong>, based on experience, job scope, completion time, and provider efficiency. Providers receive flat-rate pay per completed job—not hourly wages—and see the job scope and provider pay before acceptance. Actual effective hourly earnings vary, and jobs or earnings are not guaranteed.
            </p>
          </div>
          <h3 class="text-2xl font-bold text-[#333333] mb-4">Available services may include</h3>
          <ul class="grid sm:grid-cols-2 gap-3">
            {[
              "Recurring residential cleaning",
              "Deep cleaning",
              "Move-in and move-out cleaning",
              "Short-term-rental and turnover cleaning",
            ].map((service) => (
              <li class="flex items-start gap-3 rounded-xl border border-gray-100 p-4">
                <Icon name="check-circle" class="w-5 h-5 text-[#d26c45] shrink-0 mt-0.5" />
                <span class="text-gray-700">{service}</span>
              </li>
            ))}
          </ul>
        </div>

        <aside class="rounded-3xl bg-[#333333] text-white p-8 shadow-xl lg:sticky lg:top-28">
          <h2 class="text-3xl font-bold mb-6">A strong fit looks like this</h2>
          <ul class="space-y-4">
            {qualifications.map((qualification) => (
              <li class="flex items-start gap-3">
                <Icon name="check" class="w-5 h-5 text-[#FFC67D] shrink-0 mt-0.5" />
                <span class="text-gray-100 leading-relaxed">{qualification}</span>
              </li>
            ))}
          </ul>
          <div class="mt-8 pt-7 border-t border-white/15">
            <p class="text-sm uppercase tracking-wider text-[#FFC67D] font-bold mb-3">Service area</p>
            <p class="text-gray-200 leading-relaxed">{job.nearbyAreas.join(" · ")}</p>
          </div>
        </aside>
      </div>
    </section>

    <section class="py-20 px-6 bg-[#f7f8f9]">
      <div class="container mx-auto max-w-6xl">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <p class="text-sm uppercase tracking-[0.18em] text-[#b85835] font-bold mb-3">What happens after you apply</p>
          <h2 class="text-3xl md:text-4xl font-bold text-[#333333]">A straightforward four-step process</h2>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {processSteps.map((step, index) => (
            <article class="rounded-2xl bg-white p-7 border border-gray-100 shadow-sm">
              <p class="w-10 h-10 rounded-full bg-[#FFA985] text-[#333333] flex items-center justify-center font-bold mb-5">{index + 1}</p>
              <h3 class="text-xl font-bold text-[#333333] mb-3">{step.title}</h3>
              <p class="text-gray-600 leading-relaxed">{step.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 px-6 bg-white">
      <div class="container mx-auto max-w-4xl">
        <h2 class="text-3xl font-bold text-[#333333] mb-6">Important provider details</h2>
        <div class="space-y-4 text-gray-700 leading-relaxed">
          <p>
            This is an independent-contractor/provider opportunity, not an offer of employment. Providers manage their own availability and service area, use their own reliable transportation, supplies, and equipment, and decide whether to accept an available assignment.
          </p>
          <p>
            Qualified applicants complete a short application, initial screening, video interview, and paid test clean. Providers who successfully complete the process may be invited to finish onboarding and join our ready-provider network. Completion of the process does not guarantee assignments or earnings.
          </p>
          <p>
            The Valley Clean Team considers qualified providers without unlawful discrimination. Any background screening will be conducted through an authorized process with required notices and consent.
          </p>
        </div>
      </div>
    </section>

    <section class="py-20 px-6 bg-[#333333] text-white">
      <div class="container mx-auto max-w-4xl text-center">
        <Icon name="sparkles" class="w-10 h-10 text-[#FFC67D] mx-auto mb-5" />
        <h2 class="text-3xl md:text-5xl font-bold mb-5">Ready to grow your cleaning business?</h2>
        <p class="text-xl text-gray-200 mb-8">Complete the short provider application and tell us where and when you are available.</p>
        <a
          href={applicationUrl}
          class="inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#FFA985] to-[#FFC67D] px-9 py-4 text-lg font-bold text-[#333333] shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all"
        >
          Start Your Application
          <Icon name="arrow-right" class="w-5 h-5" />
        </a>
        <p class="mt-5 text-sm text-gray-300">Questions? <a href="mailto:careers@thevalleycleanteam.com" class="underline hover:text-white">careers@thevalleycleanteam.com</a></p>
      </div>
    </section>
  </main>
</BaseLayout>
