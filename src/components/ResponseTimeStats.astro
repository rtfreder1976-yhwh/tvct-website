---
import Icon from './Icon.astro';
import { PERFORMANCE } from '../data/claims';

const quoteSla = PERFORMANCE.quoteResponseSla;
---

<section class="py-16 px-6 bg-gradient-to-br from-[#333333] to-[#444444]">
  <div class="container mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">
        Our Commitment to You
      </h2>
      <p class="text-gray-300 text-lg">Reliable service backed by the numbers we actually track</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-5xl mx-auto mb-12">
      <div class="bg-white/10 backdrop-blur rounded-2xl p-6 text-center border border-white/20">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gradient-to-br from-[#FFA985] to-[#FFC67D] flex items-center justify-center">
          <Icon name="bolt" class="w-6 h-6 text-white" />
        </div>
        <p class="text-3xl font-bold text-white mb-1">{quoteSla}</p>
        <p class="text-sm text-gray-300">Quote Response SLA</p>
        <p class="text-xs text-[#FFA985] mt-2">During business hours</p>
      </div>

      <div class="bg-white/10 backdrop-blur rounded-2xl p-6 text-center border border-white/20">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gradient-to-br from-[#FFA985] to-[#FFC67D] flex items-center justify-center">
          <Icon name="clock" class="w-6 h-6 text-white" />
        </div>
        <p class="text-4xl font-bold text-white mb-1">{PERFORMANCE.onTimeArrivalPct}%</p>
        <p class="text-sm text-gray-300">On-Time Arrival</p>
        <p class="text-xs text-[#FFA985] mt-2">BookingKoala reporting</p>
      </div>

      <div class="bg-white/10 backdrop-blur rounded-2xl p-6 text-center border border-white/20">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gradient-to-br from-[#FFA985] to-[#FFC67D] flex items-center justify-center">
          <Icon name="redo" class="w-6 h-6 text-white" />
        </div>
        <p class="text-4xl font-bold text-white mb-1">{PERFORMANCE.repeatCustomerPct}%</p>
        <p class="text-sm text-gray-300">Repeat Customers</p>
        <p class="text-xs text-[#FFA985] mt-2">BookingKoala reporting</p>
      </div>

      <div class="bg-white/10 backdrop-blur rounded-2xl p-6 text-center border border-white/20">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gradient-to-br from-[#FFA985] to-[#FFC67D] flex items-center justify-center">
          <Icon name="users" class="w-6 h-6 text-white" />
        </div>
        <p class="text-4xl font-bold text-white mb-1">{PERFORMANCE.customersServedDisplay}</p>
        <p class="text-sm text-gray-300">Customers Served</p>
        <p class="text-xs text-[#FFA985] mt-2">Verified business metric</p>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      <div class="bg-white rounded-2xl p-6 shadow-lg">
        <h3 class="font-bold text-[#333333] mb-4 flex items-center">
          <Icon name="stopwatch" class="w-5 h-5 text-[#FFA985] mr-2" />
          Response Time Promise
        </h3>
        <p class="text-gray-600">
          Text or message us and you'll usually hear back in minutes during business hours. Every written quote request is answered within {quoteSla}, worst case. Short-notice cleaning is handled on a best-effort basis depending on team availability.
        </p>
      </div>

      <div class="bg-white rounded-2xl p-6 shadow-lg">
        <h3 class="font-bold text-[#333333] mb-4 flex items-center">
          <Icon name="chart-line" class="w-5 h-5 text-[#FFA985] mr-2" />
          Team Experience
        </h3>
        <p class="text-gray-600">
          Our cleaners average {PERFORMANCE.avgCleanerExperienceYears} years of professional cleaning experience.
        </p>
      </div>
    </div>

    <div class="text-center mt-12">
      <p class="text-gray-300 mb-4">{PERFORMANCE.customersServedDisplay} customers served. Your clean home can be next.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:2568261100" class="bg-gradient-to-r from-[#FFA985] to-[#FFC67D] text-[#333333] px-8 py-4 rounded-full font-bold text-lg shadow-lg hover:shadow-xl transition">
          <Icon name="phone" class="w-5 h-5 mr-2" />256-826-1100
        </a>
        
      </div>
    </div>
  </div>
</section>
