---
import {
  cityConfigs,
  petSafeServiceCatalog,
  BUSINESS_HOURS,
  type CityConfig,
} from "../constants/schemaData";
import { IDENTITY, PRICE_RANGE_BAND, PRICING, REVIEWS } from "../data/claims";

interface Props {
  type?: "organization" | "local" | "service" | "article";
  city?: string;
  state?: string;
  neighborhoods?: string[];
  serviceName?: string;
  servicePrice?: string;
  serviceDescription?: string;
  title?: string;
  description?: string;
  publishDate?: string;
  modifiedDate?: string;
  author?: string;
  authorId?: string;
  authorTitle?: string;
  image?: string;
  howToSteps?: Array<{ name: string; text: string; image?: string }>;
  totalTime?: string;
  faqs?: Array<{ question: string; answer: string } | { q: string; a: string }>;
  canonical?: string;
}

const {
  type = "organization",
  city,
  state,
  neighborhoods = [],
  serviceName,
  servicePrice,
  serviceDescription,
  title,
  description,
  publishDate,
  modifiedDate,
  author = "The Valley Clean Team",
  authorId,
  authorTitle,
  image,
  howToSteps,
  totalTime,
  canonical: canonicalProp,
} = Astro.props;

const canonicalURL = canonicalProp || Astro.url.href;

const departmentSchemas = Object.entries(cityConfigs).map(
  ([cityName, config]) => ({
    "@type": "LocalBusiness",
    "@id": `https://thevalleycleanteam.com/locations/${cityName.toLowerCase().replace(/\s+/g, "-")}/#localbusiness`,
    name: `The Valley Clean Team - ${cityName}`,
    telephone: config.phone,
    areaServed: [
      { "@type": "City", name: cityName },
      { "@type": "AdministrativeArea", name: `ZIP ${config.zips}` },
      {
        "@type": "GeoCircle",
        geoMidpoint: {
          "@type": "GeoCoordinates",
          latitude: Number(config.lat),
          longitude: Number(config.lng),
        },
        geoRadius: Number(config.radius),
      },
    ],
    address: {
      "@type": "PostalAddress",
      addressLocality: cityName,
      addressRegion: config.stateAbbr,
      addressCountry: "US",
    },
  }),
);

const getOrganizationSchema = (includeDepartments = true) => ({
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://thevalleycleanteam.com/#organization",
  name: "The Valley Clean Team",
  alternateName: ["TVCT", "Valley Clean Team"],
  description:
    "Residential and commercial cleaning services across North Alabama, the Shoals, Mountain Brook, and the Nashville area.",
  url: "https://thevalleycleanteam.com",
  telephone: "+1-256-826-1100",
  email: "hello@thevalleycleanteam.com",
  logo: {
    "@type": "ImageObject",
    url: "https://thevalleycleanteam.com/og-image.png",
    width: 512,
    height: 512,
  },
  image: ["https://thevalleycleanteam.com/og-image.png"],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Cleaning Services",
    itemListElement: petSafeServiceCatalog,
  },
  knowsAbout: [
    "House Cleaning",
    "Deep Cleaning",
    "Move Out Cleaning",
    "Move In Cleaning",
    "Office Cleaning",
    "Commercial Cleaning",
    "Airbnb Cleaning",
    "Vacation Rental Cleaning",
    "Post Construction Cleaning",
  ],
  additionalProperty: [
    {
      "@type": "PropertyValue",
      name: "Veteran-Owned",
      value: IDENTITY.isVeteranOwned,
    },
    {
      "@type": "PropertyValue",
      name: "Woman-Owned",
      value: IDENTITY.isWomanOwned,
    },
    {
      "@type": "PropertyValue",
      name: "Family-Owned",
      value: IDENTITY.isFamilyOwned,
    },
  ],
  priceRange: PRICE_RANGE_BAND,
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: REVIEWS.rating,
    reviewCount: String(REVIEWS.count),
    bestRating: "5",
    worstRating: "1",
  },
  isicV4: "9601",
  naics: "561720",
  sameAs: [
    "https://www.facebook.com/thevalleycleanteam/",
    "https://www.instagram.com/thevalleycleanteamal/",
    "https://www.linkedin.com/company/thevalleycleanteam",
    "https://www.google.com/maps?cid=2354162289321042477",
    "https://www.yelp.com/biz/the-valley-clean-team-huntsville",
  ],
  ...(includeDepartments ? { department: departmentSchemas } : {}),
  potentialAction: [
    {
      "@type": "ReserveAction",
      target: {
        "@type": "EntryPoint",
        urlTemplate: "https://thevalleycleanteam.bookingkoala.com/booknow/home_cleaning",
        actionPlatform: [
          "https://schema.org/DesktopWebPlatform",
          "https://schema.org/MobileWebPlatform",
        ],
      },
      result: { "@type": "Reservation", name: "Cleaning Service Booking" },
    },
    {
      "@type": "CommunicateAction",
      target: {
        "@type": "EntryPoint",
        urlTemplate: "tel:+1-256-826-1100",
        actionPlatform: "https://schema.org/MobileWebPlatform",
      },
    },
  ],
});

const organizationSchema = getOrganizationSchema(true);

const getCityConfig = (cityName: string): CityConfig =>
  cityConfigs[cityName] || cityConfigs["Huntsville"];

const localSchema = city
  ? (() => {
      const config = getCityConfig(city);
      const stateAbbr = state === "Tennessee" || state === "TN" ? "TN" : "AL";
      const citySlug = city.toLowerCase().replace(/\s+/g, "-");

      return {
        "@context": "https://schema.org",
        "@type": "HomeAndConstructionBusiness",
        "@id": `https://thevalleycleanteam.com/locations/${citySlug}/#localbusiness`,
        name: `The Valley Clean Team - ${city}`,
        description: `Professional cleaning in ${city}, ${state ?? stateAbbr}. ${REVIEWS.rating}â˜… from ${REVIEWS.count} Google reviews.`,
        url: `https://thevalleycleanteam.com/locations/${citySlug}`,
        telephone: config.phone,
        email: "hello@thevalleycleanteam.com",
        image: "https://thevalleycleanteam.com/og-image.png",
        priceRange: PRICE_RANGE_BAND,
        areaServed: [
          { "@type": "City", name: city },
          { "@type": "AdministrativeArea", name: `ZIP ${config.zips}` },
          {
            "@type": "GeoCircle",
            geoMidpoint: {
              "@type": "GeoCoordinates",
              latitude: Number(config.lat),
              longitude: Number(config.lng),
            },
            geoRadius: Number(config.radius),
          },
          ...neighborhoods.map((neighborhood) => ({
            "@type": "Place",
            name: neighborhood,
            containedInPlace: { "@type": "City", name: city },
          })),
        ],
        address: {
          "@type": "PostalAddress",
          addressLocality: city,
          addressRegion: stateAbbr,
          addressCountry: "US",
        },
        parentOrganization: { "@id": "https://thevalleycleanteam.com/#organization" },
        openingHoursSpecification: BUSINESS_HOURS.schema,
        hasOfferCatalog: {
          "@type": "OfferCatalog",
          name: `Cleaning services in ${city}`,
          itemListElement: [
            {
              "@type": "Offer",
              itemOffered: {
                "@type": "Service",
                name: `Regular Cleaning ${city} ${stateAbbr}`,
              },
              priceSpecification: {
                "@type": "PriceSpecification",
                price: PRICING.regular.amount,
                priceCurrency: "USD",
                description: `From ${PRICING.regular.display}`,
              },
            },
            {
              "@type": "Offer",
              itemOffered: { "@type": "Service", name: `Deep Cleaning ${city} ${stateAbbr}` },
              priceSpecification: {
                "@type": "PriceSpecification",
                price: PRICING.deep.amount,
                priceCurrency: "USD",
                description: `From ${PRICING.deep.display}`,
              },
            },
            {
              "@type": "Offer",
              itemOffered: { "@type": "Service", name: `Move In/Out Cleaning ${city} ${stateAbbr}` },
              priceSpecification: {
                "@type": "PriceSpecification",
                price: PRICING.moveInOut.amount,
                priceCurrency: "USD",
                description: `From ${PRICING.moveInOut.display}`,
              },
            },
          ],
        },
      };
    })()
  : null;

const areasServed = Object.entries(cityConfigs).map(([cityName, config]) => ({
  "@type": "City",
  name: cityName,
  containedInPlace: { "@type": "State", name: config.state },
}));

const serviceSchema = serviceName
  ? (() => {
      const cityConfig = city ? getCityConfig(city) : null;
      const stateAbbr = state === "Tennessee" || state === "TN" ? "TN" : "AL";
      const citySlug = city ? city.toLowerCase().replace(/\s+/g, "-") : "";
      const servicePrice_ = servicePrice?.replace(/[^0-9.]/g, "");
      const providerId = city
        ? `https://thevalleycleanteam.com/locations/${citySlug}/#localbusiness`
        : "https://thevalleycleanteam.com/#organization";

      return {
        "@context": "https://schema.org",
        "@type": "Service",
        serviceType: serviceName,
        provider: { "@id": providerId },
        areaServed: city
          ? {
              "@type": "AdministrativeArea",
              name: `${city} ${stateAbbr} ZIP ${cityConfig?.zips?.split("-")[0] || ""}`.trim(),
            }
          : areasServed,
        ...(serviceDescription ? { description: serviceDescription } : {}),
        ...(servicePrice_ && {
          offers: {
            "@type": "Offer",
            priceCurrency: "USD",
            price: servicePrice_,
          },
        }),
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": canonicalURL,
        },
      };
    })()
  : null;

const articleSchema =
  type === "article" && title
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        image: image || "https://thevalleycleanteam.com/og-image.png",
        ...(publishDate ? { datePublished: new Date(publishDate).toISOString() } : {}),
        ...(modifiedDate
          ? { dateModified: new Date(modifiedDate).toISOString() }
          : publishDate
            ? { dateModified: new Date(publishDate).toISOString() }
            : {}),
        author: authorId
          ? {
              "@type": "Person",
              "@id": authorId,
              name: author,
              ...(authorTitle ? { jobTitle: authorTitle } : {}),
              worksFor: { "@id": "https://thevalleycleanteam.com/#organization" },
            }
          : { "@id": "https://thevalleycleanteam.com/#organization" },
        publisher: { "@id": "https://thevalleycleanteam.com/#organization" },
        mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL },
        inLanguage: "en-US",
      }
    : null;

const howToSchema =
  type === "article" && howToSteps?.length
    ? {
        "@context": "https://schema.org",
        "@type": "HowTo",
        name: title,
        description,
        ...(image ? { image } : {}),
        ...(totalTime ? { totalTime } : {}),
        step: howToSteps.map((step, index) => ({
          "@type": "HowToStep",
          position: index + 1,
          name: step.name,
          text: step.text,
          ...(step.image ? { image: step.image } : {}),
        })),
        author: { "@id": "https://thevalleycleanteam.com/#organization" },
      }
    : null;

const breadcrumbSchema =
  type === "local" && city
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Home", item: "https://thevalleycleanteam.com" },
          { "@type": "ListItem", position: 2, name: "Locations", item: "https://thevalleycleanteam.com/locations" },
          {
            "@type": "ListItem",
            position: 3,
            name: `${city} Cleaning`,
            item: `https://thevalleycleanteam.com/locations/${city.toLowerCase().replace(/\s+/g, "-")}`,
          },
          ...(serviceName &&
          canonicalURL.replace(/\/$/, "") !==
            `https://thevalleycleanteam.com/locations/${city.toLowerCase().replace(/\s+/g, "-")}`
            ? [{ "@type": "ListItem", position: 4, name: serviceName, item: canonicalURL }]
            : []),
        ],
      }
    : null;

const airbnbCleaningSchema =
  serviceName?.toLowerCase().includes("airbnb")
    ? {
        "@context": "https://schema.org",
        "@type": "Service",
        "@id": "https://thevalleycleanteam.com/services/airbnb-cleaning/#service",
        serviceType: "Vacation Rental Cleaning",
        name: "Airbnb & Vacation Rental Cleaning",
        provider: { "@id": "https://thevalleycleanteam.com/#organization" },
        offers: {
          "@type": "Offer",
          priceSpecification: {
            "@type": "PriceSpecification",
            price: PRICING.airbnbTurnover.amount,
            priceCurrency: "USD",
            description: "Starting price for standard turnover",
          },
        },
      }
    : null;

const moveOutCleaningSchema =
  serviceName?.toLowerCase().includes("move")
    ? {
        "@context": "https://schema.org",
        "@type": "Service",
        "@id": "https://thevalleycleanteam.com/services/move-in-out-cleaning/#service",
        serviceType: "Move-In/Out Cleaning",
        name: "Move-Out & Move-In Cleaning",
        provider: { "@id": "https://thevalleycleanteam.com/#organization" },
        offers: {
          "@type": "Offer",
          priceSpecification: {
            "@type": "PriceSpecification",
            price: PRICING.moveInOut.amount,
            priceCurrency: "USD",
            description: "Starting price for move-in/out cleaning",
          },
        },
      }
    : null;

const schemaToUse =
  type === "local" && city
    ? localSchema
    : type === "article"
      ? null
      : organizationSchema;
---

{type === "article" && articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
{type !== "article" && <script type="application/ld+json" set:html={JSON.stringify(schemaToUse)} />}
{serviceSchema && <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />}
{breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
{howToSchema && <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />}
{airbnbCleaningSchema && <script type="application/ld+json" set:html={JSON.stringify(airbnbCleaningSchema)} />}
{moveOutCleaningSchema && <script type="application/ld+json" set:html={JSON.stringify(moveOutCleaningSchema)} />}
