---
import StickyQuoteBar from "../components/StickyQuoteBar.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import ProblemOptions from "../components/ProblemOptions.astro";
import { standaloneServiceIntent } from "../data/serviceIntent.ts";

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "The Valley Clean Team - Dialysis Center Sanitization",
  url: "https://thevalleycleanteam.com/dialysis-center-cleaning",
  telephone: "256-826-1100",
  email: "hello@thevalleycleanteam.com",
  description: "Non-clinical cleaning for dialysis centers, run to a written routine every visit. Documented, consistent, and the same scope every time.",
};
---

<BaseLayout
  title="Dialysis Center Cleaning & Sanitization | Valley Clean Team"
  description="Non-clinical cleaning for dialysis centers, run to a written routine every visit. Documented, consistent, and the same scope every time."
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(localBusinessSchema)}
  />

  <section class="pt-32 pb-20 px-6">
    <div class="container mx-auto max-w-4xl">
      <div class="text-center mb-12">
        <h1 class="text-5xl md:text-6xl font-bold mb-4 text-[#333333]">
          Dialysis Center <span class="gold-gradient">Sanitization</span>
        </h1>
        <div class="section-divider"></div>
        <p class="text-xl text-gray-600">
          We clean the non-clinical areas of sensitive facilities to a written routine — the same scope, in the same order, every visit. Regulated clinical work stays with your staff.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12 bg-white p-8 md:p-12 rounded-3xl shadow-xl border border-gray-100">
        <!-- Quote Form -->
        <div>
          <h2 class="text-3xl font-bold mb-6 text-[#333333]">Review Our Protocol</h2>
          <a
            href="tel:2568261100"
            class="btn-primary inline-block px-8 py-4 rounded-full text-lg font-semibold text-center shadow-lg"
          >
            Request a quote
          </a>
          <p class="text-sm text-gray-500 mt-4 italic">
            *Request a 10-minute walkthrough and we’ll show you the written routine we would run in your center.
          </p>
        </div>

        <!-- Benefits/Trust -->
        <div class="space-y-8">
          <div>
            <h3 class="text-2xl font-bold mb-4 text-[#333333]">What We Are, And What We Are Not</h3>
            <p class="text-gray-600">
               We are an environmental cleaning company, not a clinical one. Our cleaners are not OSHA- or CDC-certified, and biohazard handling and clinical decontamination stay with your staff. What we do provide is a written routine, run the same way every visit, by background-checked cleaners behind $2 million in liability coverage.
            </p>
          </div>

          <div class="space-y-4">
            <div class="flex items-center space-x-4">
              <div class="w-10 h-10 rounded-full bg-[#FFA985]/10 flex items-center justify-center text-[#FFA985]">
                <Icon name="check" class="w-5 h-5" />
              </div>
              <span class="font-semibold text-[#333333]">A Written Routine, Every Visit</span>
            </div>
            <div class="flex items-center space-x-4">
              <div class="w-10 h-10 rounded-full bg-[#FFA985]/10 flex items-center justify-center text-[#FFA985]">
                <Icon name="check" class="w-5 h-5" />
              </div>
              <span class="font-semibold text-[#333333]">Cross-Contamination Prevention Guidelines</span>
            </div>
            <div class="flex items-center space-x-4">
              <div class="w-10 h-10 rounded-full bg-[#FFA985]/10 flex items-center justify-center text-[#FFA985]">
                <Icon name="check" class="w-5 h-5" />
              </div>
              <span class="font-semibold text-[#333333]">Documented Cleaning Records</span>
            </div>
            <div class="flex items-center space-x-4">
              <div class="w-10 h-10 rounded-full bg-[#FFA985]/10 flex items-center justify-center text-[#FFA985]">
                <Icon name="check" class="w-5 h-5" />
              </div>
              <span class="font-semibold text-[#333333]">Veteran-Led Quality Assurance</span>
            </div>
          </div>

          <div class="pt-6 border-t border-gray-100">
             <h4 class="font-bold text-[#333333] mb-2 text-lg">The TVCT Standard</h4>
             <p class="text-gray-600">
               A written routine for your facility, run the same way every visit — dwell times, high-touch surfaces, and the order rooms get cleaned in.
             </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Soft CTA for buyers still comparing vendors. This page has no closing CTA
       section of its own, so it sits between the content and ProblemOptions. -->
  <section class="pb-16 px-6">
    <div class="container mx-auto max-w-4xl text-center">
      <p class="text-gray-600">
        Still comparing companies?
        <a href="/commercial-hiring-sheet" class="font-semibold text-[#333333] underline decoration-[#FFA985] decoration-2 underline-offset-4 hover:text-[#FFA985] transition">
          Get the 12 questions to ask any commercial cleaner
        </a> — including us.
      </p>
    </div>
  </section>

  {standaloneServiceIntent["medical-cleaning"] && (
    <ProblemOptions
      ctaHref="/request-a-quote?service=commercial"
      heading="The dialysis center cleaning problem — and your real options"
      problem={standaloneServiceIntent["medical-cleaning"].problem}
      options={standaloneServiceIntent["medical-cleaning"].options}
      ctaLabel="Call for your flat price — quoted in minutes"
    />
  )}
  <StickyQuoteBar quoteHref="/request-a-quote?service=commercial" quoteLabel="Request a quote" />
</BaseLayout>
