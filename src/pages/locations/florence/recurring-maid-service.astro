  state="AL"
  citySlug="florence"
  serviceDescription="Enjoy a consistently clean home without lifting a finger. Our recurring maid service in Florence provides weekly, biweekly, or monthly cleaning with the same trusted team every visit. We serve busy families and professionals throughout Florence and Lauderdale County."
  price={`${RECURRING_PRICING.weekly.display}/visit`}
  benefits={[
    "Same trusted team every visit",
    "Weekly, biweekly, or monthly options",
    "Consistent results you can count on",
    "Flexible scheduling that fits your life",
    "All supplies and equipment provided",
    "Background-checked, insured cleaners",
    "Easy rescheduling when needed",
    "Serving all of Lauderdale County"
  ]}
  includes={[
      "Empty trash throughout",
      "Sweep/vacuum all floors (carpet + hard surfaces)",
      "Mop all hard surface floors",
