---
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import BlogByline from "../../components/BlogByline.astro";
import {
  PRICING,
  CHECKLIST,
  RECURRING_DISCOUNTS,
  RECURRING_MINIMUMS,
  RECURRING_PRICING,
  POLICIES,
} from "../../data/claims";

const publishDate = '2026-09-01';
const modifiedDate = '2026-09-01';
const readTime = '5 min read';

const pct = (d: number) => `${Math.round(d * 100)}%`;
const usd = (n: number) => `$${Math.ceil(n)}`;

// Per-visit prices come from claims.ts (30/25/15 off the regular base, with
// the weekly minimum applied). Month totals are a plain 4-week month.
const schedules = [
  { name: "Weekly", discount: pct(RECURRING_DISCOUNTS.weekly), visit: RECURRING_PRICING.weekly.display, visits: 4, month: usd(RECURRING_PRICING.weekly.amount * 4) },
  { name: "Biweekly", discount: pct(RECURRING_DISCOUNTS.biweekly), visit: RECURRING_PRICING.biweekly.display, visits: 2, month: usd(RECURRING_PRICING.biweekly.amount * 2) },
  { name: "Monthly", discount: pct(RECURRING_DISCOUNTS.monthly), visit: RECURRING_PRICING.monthly.display, visits: 1, month: usd(RECURRING_PRICING.monthly.amount) },
];
const weeklyMin = `$${RECURRING_MINIMUMS.weekly}`;

// FAQ: single source of truth — BlogPostLayout emits the FAQPage schema from
// this array. The visible FAQ section below must stay in sync with it.
const faqs = [
  {
    question: "Is weekly cheaper than biweekly?",
    answer: `Per visit, yes once your quote is above the ${PRICING.regular.display} start; at the start both land at ${RECURRING_PRICING.weekly.display} because weekly visits have a ${weeklyMin} minimum. Per month, no. On a ${PRICING.regular.display} start, weekly is ${RECURRING_PRICING.weekly.display} a visit and ${usd(RECURRING_PRICING.weekly.amount * 4)} in a four-visit month. Biweekly is ${RECURRING_PRICING.biweekly.display} a visit and ${usd(RECURRING_PRICING.biweekly.amount * 2)} in a two-visit month.`
  },
  {
    question: "Can I switch later?",
    answer: "Yes. Weekly to biweekly after the house is stable is common. Biweekly to weekly during allergy season or after a new puppy is also common."
  },
  {
    question: "Do I need a deep clean first?",
    answer: `If nobody has done baseboards, fans, and the tight kitchen work in months, yes. Start with deep cleaning from ${PRICING.deep.display}, then recurring regular visits from ${PRICING.regular.display}.`
  },
  {
    question: "What if I only want help once a month?",
    answer: "We will do it. Know that a monthly regular clean is not the same result as weekly. If the house is heavy, we will tell you a deep clean is the honest first step."
  }
];
---

<BlogPostLayout
  title={`Weekly vs Biweekly House Cleaning: The Math at ${PRICING.regular.display} | Valley Clean Team`}
  schemaTitle="Weekly vs Biweekly House Cleaning"
  description={`Weekly is ${pct(RECURRING_DISCOUNTS.weekly)} off a visit. Biweekly is ${pct(RECURRING_DISCOUNTS.biweekly)} off. Here is what that costs per month on a ${PRICING.regular.display} starting price — and which schedule actually keeps the house in shape.`}
  publishDate={publishDate}
  modifiedDate={modifiedDate}
  faqs={faqs}
>

  <!-- Hero Section -->
  <section class="pt-32 pb-16 px-6 bg-gradient-to-br from-[#1a1a2e] via-[#16213e] to-[#0f3460]">
    <div class="container mx-auto max-w-4xl">
      <div class="text-center">
        <span class="inline-block px-4 py-2 bg-[#FFA985]/20 text-[#FFA985] rounded-full text-sm font-semibold mb-6">
          Pricing Guide
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 text-white leading-tight">
          Weekly vs <span class="text-[#FFA985]">Biweekly</span> House Cleaning
        </h1>
        <div class="mb-8">
          <BlogByline variant="dark" date={publishDate} readTime={readTime} />
        </div>
      </div>
    </div>
  </section>

  <!-- Article Content -->
  <article class="py-16 px-6">
    <div class="container mx-auto max-w-3xl">
      <div class="prose prose-lg max-w-none">

        <p class="text-xl text-gray-700 leading-relaxed mb-8">
          Recurring house cleaning with us starts at <strong>{PRICING.regular.display}</strong> per visit. Weekly is <strong>{pct(RECURRING_DISCOUNTS.weekly)} off</strong>. Biweekly is <strong>{pct(RECURRING_DISCOUNTS.biweekly)} off</strong>. Monthly is <strong>{pct(RECURRING_DISCOUNTS.monthly)} off</strong>. Weekly visits have a {weeklyMin} minimum, so at the starting price weekly and biweekly land on the same per-visit number. On larger homes the weekly discount is the bigger one.
        </p>

        <p>
          On that {PRICING.regular.display} starting price:
        </p>

        <div class="overflow-x-auto mb-8">
          <table class="w-full text-left">
            <thead>
              <tr class="border-b-2 border-[#FFA985]">
                <th class="py-3 pr-4">Schedule</th>
                <th class="py-3 px-4">Discount</th>
                <th class="py-3 px-4">Price per visit</th>
                <th class="py-3 px-4">Visits in a 4-week month</th>
                <th class="py-3 pl-4">Month at the {PRICING.regular.display} start</th>
              </tr>
            </thead>
            <tbody>
              {schedules.map((s) => (
                <tr class="border-b border-gray-200">
                  <td class="py-3 pr-4 font-medium">{s.name}</td>
                  <td class="py-3 px-4">{s.discount}</td>
                  <td class="py-3 px-4">{s.visit}</td>
                  <td class="py-3 px-4">{s.visits}</td>
                  <td class="py-3 pl-4">{s.month}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p>
          That table is the published starting price, not a quote for your square footage. Your visit price may be higher. The discount percentages stay the same. Exact number: <a href="tel:2568261100" class="text-[#FFA985] font-semibold hover:underline">256-826-1100</a> or <a href="/request-a-quote" class="text-[#FFA985] font-semibold hover:underline">request a quote</a>. Current list: <a href="/pricing" class="text-[#FFA985] font-semibold hover:underline">pricing</a>.
        </p>

        <h2 class="text-3xl font-bold text-[#333333] mt-12 mb-6">What you are actually buying</h2>

        <p>
          Weekly and biweekly are the same <a href="/services/regular-cleaning" class="text-[#FFA985] font-semibold hover:underline">regular cleaning</a>. Same {CHECKLIST.standard}-item checklist. The difference is how much life happens between visits.
        </p>

        <p>
          Weekly is maintenance when the house does not get a chance to fall behind: kids, pets, two people working from home, pollen season.
        </p>

        <p>
          Biweekly is the usual schedule. Most of the homes we clean sit here. The house stays guest-ready if you do a light reset in between — dishes, floors in the traffic path, bathrooms.
        </p>

        <p>
          Monthly is a reset, not a rhythm. A month of cooking, shedding, and backpacks is a different job than 14 days. If the last visit was 30 days ago, you will feel it. Some months it will look closer to a <a href="/services/deep-cleaning" class="text-[#FFA985] font-semibold hover:underline">deep clean</a> than a regular one.
        </p>

        <h2 class="text-3xl font-bold text-[#333333] mt-12 mb-6">Which schedule fits</h2>

        <p>
          <strong>Weekly</strong> if two or more of these are true: dogs that shed, kids under 10, someone home most days, allergies, you want the sink empty when you walk in.
        </p>

        <p>
          <strong>Biweekly</strong> if the house is already in decent shape and you can wipe a bathroom and run a vacuum once between visits.
        </p>

        <p>
          <strong>Monthly</strong> if you want help, not a system. Fine for a low-traffic house. A poor fit if you have been disappointed by “it still looked dirty when they left.” That is often a frequency problem, not a cleaner problem.
        </p>

        <p>
          First visits in a neglected house should start with a deep clean, then drop to weekly or biweekly. A regular clean is not built to recover three months of buildup.
        </p>

        <h2 class="text-3xl font-bold text-[#333333] mt-12 mb-6">The part people miss</h2>

        <p>
          Weekly costs more per month and, above the starting price, less per visit. You are paying for the house never getting away from you.
        </p>

        <p>
          Biweekly costs less per month. You are paying for a clean slate every two weeks and doing a little yourself in the gap.
        </p>

        <p>
          There is no third option where the house stays at weekly condition on a monthly invoice. That is the trade.
        </p>

        <p>
          If you are still deciding whether to hire anyone, read <a href="/blog/is-hiring-house-cleaner-worth-it" class="text-[#FFA985] font-semibold hover:underline">Is a house cleaner worth it?</a>
        </p>

        <h2 class="text-3xl font-bold text-[#333333] mt-12 mb-6">What does not change with frequency</h2>

        <ul class="space-y-3 mb-8">
          <li>Flat quote before we arrive. The number we say is the number we bill.</li>
          <li>Pet-safe products. Green or fragrance-free on request, no extra product charge.</li>
          <li>${POLICIES.pets.feePerPet} per pet. Heavy shedding is +${POLICIES.pets.heavyShedSurcharge}. That is on <a href="/pricing" class="text-[#FFA985] font-semibold hover:underline">pricing</a>, not a surprise.</li>
          <li>Cancel inside {POLICIES.cancellation.noticeHours} hours, no-show, or lockout: ${POLICIES.cancellation.feeAmount}.</li>
          <li>Tell us within 24 hours if we missed something and we re-clean at no charge.</li>
        </ul>

        <h2 class="text-3xl font-bold text-[#333333] mt-12 mb-6">Frequently asked questions</h2>

        {faqs.map((faq) => (
          <>
            <h3 class="text-xl font-bold text-[#333333] mt-6 mb-3">{faq.question}</h3>
            <p>{faq.answer}</p>
          </>
        ))}

      </div>

      <!-- CTA Section -->
      <div class="mt-16 p-8 bg-gradient-to-br from-[#FFA985]/10 to-[#FFC67D]/10 rounded-2xl border border-[#FFA985]/20 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-[#333333] mb-4">Get a schedule and a number</h2>
        <p class="text-gray-600 mb-6">Veteran-owned. $2 million insured. Same {CHECKLIST.standard}-item checklist every regular visit.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="tel:2568261100" class="btn-primary px-8 py-4 rounded-lg font-semibold inline-flex items-center justify-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            Get your price — 256-826-1100
          </a>
          <a href="/request-a-quote" class="bg-white border-2 border-[#FFA985] text-[#333333] px-8 py-4 rounded-lg font-semibold hover:bg-[#FFA985]/10 transition inline-flex items-center justify-center">
            Request a quote online
          </a>
        </div>
        <p class="text-gray-600 mt-6">Tennessee: <a href="tel:6155101427" class="text-[#FFA985] font-semibold hover:underline">615-510-1427</a></p>
      </div>

    </div>
  </article>

</BlogPostLayout>
