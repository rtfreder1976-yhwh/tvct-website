---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { allBlogPosts } from "../constants/blogPosts";
import { PERFORMANCE } from "../data/claims";

export const prerender = false;

function dateValue(raw: string): number {
  const normalized = raw.includes(" ") && !raw.includes(",")
    ? raw.replace(/(\w+ \d+) (\d+)/, "$1, $2")
    : raw;
  return new Date(normalized).getTime();
}

const now = Date.now();
const publishedPosts = allBlogPosts
  .filter((post) => dateValue(post.date) <= now)
  .sort((a, b) => dateValue(b.date) - dateValue(a.date));
const scheduledPosts = allBlogPosts
  .filter((post) => dateValue(post.date) > now)
  .sort((a, b) => dateValue(a.date) - dateValue(b.date));

const categoryColors: Record<string, string> = {
  red: "bg-red-100 text-red-600",
  orange: "bg-orange-100 text-orange-600",
  purple: "bg-purple-100 text-purple-600",
  blue: "bg-blue-100 text-blue-600",
  teal: "bg-teal-100 text-teal-600",
  gray: "bg-gray-100 text-gray-600",
  yellow: "bg-yellow-100 text-yellow-600",
  pink: "bg-pink-100 text-pink-600",
  amber: "bg-amber-100 text-amber-600",
  green: "bg-green-100 text-green-600",
  indigo: "bg-indigo-100 text-indigo-600",
};
---

<BaseLayout
  title="Cleaning Tips & Advice - The Valley Clean Team Blog"
  description="Professional cleaning tips and practical home-care advice from The Valley Clean Team."
  ogImage="https://thevalleycleanteam.com/og-image.png"
>
  <section class="pt-32 pb-12 px-6 bg-gradient-to-br from-gray-50 to-white">
    <div class="container mx-auto text-center">
      <h1 class="text-5xl md:text-6xl font-bold mb-4 text-[#333333]">
        Cleaning Tips & <span class="gold-gradient">Expert Advice</span>
      </h1>
      <div class="section-divider"></div>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Practical cleaning, home-care, moving, rental, and facility advice from our team.
      </p>
    </div>
  </section>

  <section class="py-12 px-6">
    <div class="container mx-auto max-w-6xl">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {publishedPosts.map((post, index) => (
          <article class="bg-white rounded-2xl overflow-hidden shadow-md border border-gray-200 hover:shadow-lg transition-shadow">
            <a href={`/blog/${post.slug}`} class="block h-full">
              <div class="h-48 bg-gradient-to-br from-[#FFA985]/10 to-gray-100 flex items-center justify-center overflow-hidden">
                {post.image ? (
                  <img
                    src={post.image}
                    alt={post.title}
                    class="w-full h-full object-cover"
                    width="400"
                    height="192"
                    loading={index < 2 ? "eager" : "lazy"}
                    decoding={index < 2 ? "sync" : "async"}
                  />
                ) : (
                  <Icon name={post.icon} class="w-16 h-16 text-[#FFA985]" />
                )}
              </div>
              <div class="p-6">
                <div class="flex items-center flex-wrap gap-2 mb-3">
                  <span class={`${categoryColors[post.categoryColor] ?? categoryColors.gray} inline-block text-xs font-semibold px-3 py-1 rounded-full`}>
                    {post.category}
                  </span>
                  <time class="text-gray-500 text-sm">{post.date}</time>
                </div>
                <h2 class="text-xl font-bold mb-3 text-[#333333]">{post.title}</h2>
                <p class="text-gray-600 mb-4">{post.excerpt}</p>
                <span class="text-[#FFA985] font-semibold">Read More →</span>
              </div>
            </a>
          </article>
        ))}
      </div>

      {scheduledPosts.length > 0 && (
        <section class="mt-20 pt-12 border-t border-gray-200" aria-labelledby="coming-soon-heading">
          <h2 id="coming-soon-heading" class="text-3xl font-bold text-[#333333] text-center mb-8">Coming Soon</h2>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {scheduledPosts.map((post) => (
              <article class="bg-gray-50 rounded-xl border border-gray-200 p-6">
                <p class="text-xs font-bold text-[#FFA985] uppercase tracking-widest mb-3">{post.category}</p>
                <h3 class="text-lg font-bold text-gray-800 mb-3">{post.title}</h3>
                <p class="text-sm text-gray-500">Scheduled for {post.date}</p>
              </article>
            ))}
          </div>
        </section>
      )}
    </div>
  </section>

  <section class="py-16 px-6 bg-gray-50">
    <div class="container mx-auto max-w-3xl text-center">
      <Icon name="envelope" class="w-12 h-12 text-[#FFA985] mb-4" />
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-[#333333]">Newsletter Signup Temporarily Paused</h2>
      <p class="text-lg text-gray-600 mb-6">
        We're rebuilding the newsletter signup so subscriptions go to the right system. No email is being collected on this page until that connection is ready.
      </p>
      <a href="https://thevalleycleanteam.bookingkoala.com/booknow" class="btn-primary px-8 py-4 rounded-full font-semibold inline-block">
        Need Cleaning? See Your Price
      </a>
      <p class="text-sm text-gray-500 mt-4">Quote requests are answered within {PERFORMANCE.quoteResponseSla}.</p>
    </div>
  </section>
</BaseLayout>
