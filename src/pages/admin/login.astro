---
export const prerender = false;

import {
  ADMIN_SECRET_MIN_LENGTH,
  adminSecretMatches,
  authorizeAdmin,
  createAdminSessionCookie,
  normalizeAdminSecret,
} from "../../lib/adminAuth";

const ADMIN_SECRET = normalizeAdminSecret(import.meta.env.ADMIN_SECRET);

Astro.response.headers.set("Cache-Control", "private, no-store, max-age=0");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");

const existingSession = authorizeAdmin(Astro.url, Astro.request, ADMIN_SECRET);
if (Astro.request.method === "GET" && existingSession.ok) {
  return Astro.redirect("/admin/dashboard", 303);
}

let errorMessage = "";

if (!ADMIN_SECRET || ADMIN_SECRET.length < ADMIN_SECRET_MIN_LENGTH) {
  Astro.response.status = 503;
  errorMessage = "Admin access is not configured correctly on this deployment.";
} else if (Astro.request.method === "POST") {
  const origin = Astro.request.headers.get("origin");
  if (origin && origin !== Astro.url.origin) {
    Astro.response.status = 403;
    errorMessage = "This sign-in request was rejected.";
  } else {
    const form = await Astro.request.formData();
    const submitted = form.get("secret");
    const candidate = typeof submitted === "string" ? submitted : undefined;

    if (adminSecretMatches(candidate, ADMIN_SECRET)) {
      const cookie = createAdminSessionCookie(ADMIN_SECRET);
      if (!cookie) {
        return new Response("Admin access is not configured correctly.", {
          status: 503,
          headers: {
            "Content-Type": "text/plain; charset=utf-8",
            "Cache-Control": "private, no-store, max-age=0",
            "Referrer-Policy": "no-referrer",
            "X-Robots-Tag": "noindex, nofollow",
          },
        });
      }

      return new Response(null, {
        status: 303,
        headers: {
          Location: "/admin/dashboard",
          "Set-Cookie": cookie,
          "Cache-Control": "private, no-store, max-age=0",
          "Referrer-Policy": "no-referrer",
          "X-Robots-Tag": "noindex, nofollow",
        },
      });
    }

    Astro.response.status = 401;
    errorMessage = "Invalid admin secret.";
  }
} else if (Astro.request.method !== "GET") {
  return new Response("Method not allowed", {
    status: 405,
    headers: {
      Allow: "GET, POST",
      "Content-Type": "text/plain; charset=utf-8",
      "Cache-Control": "private, no-store, max-age=0",
      "Referrer-Policy": "no-referrer",
      "X-Robots-Tag": "noindex, nofollow",
    },
  });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>Admin Sign In | The Valley Clean Team</title>
    <style is:inline>
      :root { color-scheme: light; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
        background: #f4f5f7;
        color: #252525;
      }
      main {
        width: min(100%, 420px);
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08);
        padding: 32px;
      }
      h1 { margin: 0 0 8px; font-size: 1.55rem; }
      p { margin: 0 0 24px; color: #60646c; line-height: 1.5; }
      label { display: block; font-weight: 650; margin-bottom: 8px; }
      input {
        width: 100%;
        min-height: 48px;
        border: 1px solid #c9cdd3;
        border-radius: 10px;
        padding: 10px 12px;
        font: inherit;
      }
      input:focus { outline: 3px solid rgba(255, 169, 133, 0.35); border-color: #d97f59; }
      button {
        width: 100%;
        min-height: 48px;
        margin-top: 16px;
        border: 0;
        border-radius: 10px;
        background: #333;
        color: #fff;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
      }
      button:hover { background: #1f1f1f; }
      .error {
        margin: 0 0 18px;
        padding: 12px 14px;
        border-radius: 10px;
        background: #fff1f1;
        color: #8b1e1e;
        font-size: 0.92rem;
      }
      .note { margin-top: 18px; margin-bottom: 0; font-size: 0.82rem; color: #777; }
    </style>
  </head>
  <body>
    <main>
      <h1>Admin sign in</h1>
      <p>Enter the deployment admin secret to create a temporary signed session.</p>

      {errorMessage && <div class="error" role="alert">{errorMessage}</div>}

      <form method="post" action="/admin/login" autocomplete="on">
        <label for="secret">Admin secret</label>
        <input
          id="secret"
          name="secret"
          type="password"
          autocomplete="current-password"
          required
          minlength={ADMIN_SECRET_MIN_LENGTH}
          autofocus
        />
        <button type="submit">Sign in</button>
      </form>

      <p class="note">The secret is submitted in the request body, not placed in the URL. Sessions expire after eight hours.</p>
    </main>
  </body>
</html>
