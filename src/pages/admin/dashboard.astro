---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { REVIEWS } from "../../data/claims";
import { authorizeAdmin, normalizeAdminSecret } from "../../lib/adminAuth";

const ADMIN_SECRET = normalizeAdminSecret(import.meta.env.ADMIN_SECRET);
const auth = authorizeAdmin(
  Astro.url,
  Astro.request,
  ADMIN_SECRET,
  "/admin/dashboard",
);

if (!auth.ok) return auth.response;
if (auth.setCookie) Astro.response.headers.set("Set-Cookie", auth.setCookie);

interface RankingRow {
  keyword: string;
  position: number | null;
  clicks: number;
  impressions: number;
  ctr: string;
  url: string;
}

interface RankingsData {
  rankings: RankingRow[];
  avgPosition: string | null;
  totalKeywords: number;
  dateRange?: { start: string; end: string };
  site?: { url: string; source: string; warning?: string };
}

interface TrafficData {
  current: {
    sessions: number;
    pageviews: number;
    avgDuration: string;
    bounceRate: number;
    activeUsers: number;
  };
  previous: {
    sessions: number;
    pageviews: number;
    avgDuration: string;
    bounceRate: number;
  };
  monthlyTrendPoints: Array<{ month: string; sessions: number }>;
  topPages: Array<{ page: string; sessions: number; conversions: number }>;
  dateRange?: { start: string; end: string };
  property?: { id: string; source: string; warning?: string };
}

interface ApiEnvelope<T> {
  success?: boolean;
  data?: T;
  error?: string;
  message?: string;
}

async function fetchAdminData<T>(path: string): Promise<ApiEnvelope<T>> {
  try {
    const response = await fetch(`${Astro.url.origin}${path}`, {
      headers: { "x-admin-key": ADMIN_SECRET },
      cache: "no-store",
    });
    const body = (await response.json()) as ApiEnvelope<T>;
    return response.ok ? body : { ...body, success: false };
  } catch (error) {
    return {
      success: false,
      error: "Request failed",
      message: error instanceof Error ? error.message : String(error),
    };
  }
}

const [rankingsResponse, trafficResponse] = await Promise.all([
  fetchAdminData<RankingsData>("/api/rankings"),
  fetchAdminData<TrafficData>("/api/traffic"),
]);

const rankings = rankingsResponse.success && rankingsResponse.data
  ? rankingsResponse.data
  : null;
const traffic = trafficResponse.success && trafficResponse.data
  ? trafficResponse.data
  : null;

const number = (value: number | null | undefined): string =>
  value === null || value === undefined || Number.isNaN(value)
    ? "—"
    : value.toLocaleString();

const changePct = (current?: number, previous?: number): string => {
  if (current === undefined || previous === undefined || previous <= 0) return "—";
  const change = ((current - previous) / previous) * 100;
  return `${change >= 0 ? "+" : ""}${change.toFixed(1)}%`;
};

const monthLabel = (yearMonth: string): string => {
  const match = /^(\d{4})(\d{2})$/.exec(yearMonth);
  if (!match) return yearMonth;
  return new Date(Number(match[1]), Number(match[2]) - 1, 1).toLocaleString("default", {
    month: "short",
    year: "2-digit",
  });
};

const trafficPeak = Math.max(
  ...(traffic?.monthlyTrendPoints ?? []).map((point) => point.sessions),
  1,
);
---

<BaseLayout
  title="SEO Dashboard | Admin"
  description="Internal Search Console and Google Analytics dashboard"
  noindex={true}
  showNav={false}
  showFooter={false}
>
  <div class="min-h-screen bg-gray-100 text-[#333]">
    <header class="bg-[#333] text-white px-6 py-5">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        <div>
          <h1 class="text-2xl font-bold">The Valley Clean Team</h1>
          <p class="text-gray-300 text-sm">Search & traffic dashboard</p>
        </div>
        <div class="text-sm text-gray-300">
          Generated {new Date().toLocaleString()}
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-8 space-y-8">
      <section class="grid md:grid-cols-2 xl:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl p-5 shadow-sm">
          <p class="text-sm text-gray-500">Tracked Keywords</p>
          <p class="text-3xl font-bold mt-1">{number(rankings?.totalKeywords)}</p>
          <p class="text-xs text-gray-400 mt-2">Google Search Console</p>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm">
          <p class="text-sm text-gray-500">Average Position</p>
          <p class="text-3xl font-bold mt-1">{rankings?.avgPosition ?? "—"}</p>
          <p class="text-xs text-gray-400 mt-2">Last 30 days</p>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm">
          <p class="text-sm text-gray-500">Sessions</p>
          <p class="text-3xl font-bold mt-1">{number(traffic?.current.sessions)}</p>
          <p class="text-xs text-gray-400 mt-2">
            {changePct(traffic?.current.sessions, traffic?.previous.sessions)} vs prior period
          </p>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm">
          <p class="text-sm text-gray-500">Google Reviews</p>
          <p class="text-3xl font-bold mt-1">{REVIEWS.rating} ★</p>
          <p class="text-xs text-gray-400 mt-2">{REVIEWS.count} verified reviews</p>
        </div>
      </section>

      <section class="grid lg:grid-cols-2 gap-8">
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
          <div class="p-5 border-b border-gray-100">
            <div class="flex items-center justify-between gap-4">
              <h2 class="text-lg font-bold">Keyword Rankings</h2>
              <span class={`text-xs px-2 py-1 rounded-full ${rankings ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700"}`}>
                {rankings ? "GSC live" : "GSC unavailable"}
              </span>
            </div>
            {rankings?.site?.url && (
              <p class="text-xs text-gray-400 mt-1">Property: {rankings.site.url}</p>
            )}
            {rankings?.site?.warning && (
              <p class="text-xs text-amber-600 mt-1">{rankings.site.warning}</p>
            )}
          </div>

          {!rankings ? (
            <div class="p-8 text-sm text-gray-500">
              <p class="font-medium text-gray-700">Search Console data is unavailable.</p>
              <p class="mt-2">{rankingsResponse.message ?? rankingsResponse.error ?? "Check the Google service-account configuration."}</p>
            </div>
          ) : rankings.rankings.length === 0 ? (
            <div class="p-8 text-sm text-gray-500">No tracked keyword rows were returned for this period.</div>
          ) : (
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead class="bg-gray-50 text-gray-600">
                  <tr>
                    <th class="px-4 py-3 text-left">Keyword</th>
                    <th class="px-4 py-3 text-right">Position</th>
                    <th class="px-4 py-3 text-right">Clicks</th>
                    <th class="px-4 py-3 text-right">Impressions</th>
                  </tr>
                </thead>
                <tbody>
                  {rankings.rankings.map((row: RankingRow) => (
                    <tr class="border-t border-gray-100">
                      <td class="px-4 py-3">
                        <span class="font-medium">{row.keyword}</span>
                        {row.url && <span class="block text-xs text-gray-400 truncate max-w-xs">{row.url}</span>}
                      </td>
                      <td class="px-4 py-3 text-right font-semibold">{number(row.position)}</td>
                      <td class="px-4 py-3 text-right">{number(row.clicks)}</td>
                      <td class="px-4 py-3 text-right">{number(row.impressions)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>

        <div class="bg-white rounded-xl shadow-sm p-5">
          <div class="flex items-center justify-between gap-4 mb-5">
            <h2 class="text-lg font-bold">Traffic</h2>
            <span class={`text-xs px-2 py-1 rounded-full ${traffic ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700"}`}>
              {traffic ? "GA4 live" : "GA4 unavailable"}
            </span>
          </div>

          {!traffic ? (
            <div class="py-6 text-sm text-gray-500">
              <p class="font-medium text-gray-700">Analytics data is unavailable.</p>
              <p class="mt-2">{trafficResponse.message ?? trafficResponse.error ?? "Check the Google service-account configuration."}</p>
            </div>
          ) : (
            <>
              <div class="grid grid-cols-2 gap-3 mb-6">
                <div class="bg-gray-50 rounded-lg p-4">
                  <p class="text-xs text-gray-500">Pageviews</p>
                  <p class="text-2xl font-bold">{number(traffic.current.pageviews)}</p>
                </div>
                <div class="bg-gray-50 rounded-lg p-4">
                  <p class="text-xs text-gray-500">Active Users</p>
                  <p class="text-2xl font-bold">{number(traffic.current.activeUsers)}</p>
                </div>
                <div class="bg-gray-50 rounded-lg p-4">
                  <p class="text-xs text-gray-500">Avg. Session</p>
                  <p class="text-2xl font-bold">{traffic.current.avgDuration}</p>
                </div>
                <div class="bg-gray-50 rounded-lg p-4">
                  <p class="text-xs text-gray-500">Bounce Rate</p>
                  <p class="text-2xl font-bold">{traffic.current.bounceRate}%</p>
                </div>
              </div>

              <h3 class="font-semibold text-sm mb-3">Monthly sessions</h3>
              {traffic.monthlyTrendPoints.length === 0 ? (
                <p class="text-sm text-gray-500">No monthly trend rows returned.</p>
              ) : (
                <div class="h-44 flex items-end gap-2">
                  {traffic.monthlyTrendPoints.map((point: { month: string; sessions: number }) => (
                    <div class="flex-1 min-w-0 flex flex-col justify-end items-center h-full">
                      <div
                        class="w-full max-w-12 bg-[#FFA985] rounded-t"
                        style={`height: ${Math.max((point.sessions / trafficPeak) * 120, 2)}px`}
                        title={`${monthLabel(point.month)}: ${point.sessions.toLocaleString()} sessions`}
                      ></div>
                      <span class="text-[10px] text-gray-500 mt-2 whitespace-nowrap">{monthLabel(point.month)}</span>
                    </div>
                  ))}
                </div>
              )}
            </>
          )}
        </div>
      </section>

      <section class="grid lg:grid-cols-2 gap-8">
        <div class="bg-white rounded-xl shadow-sm p-5">
          <h2 class="text-lg font-bold mb-4">Top Pages</h2>
          {!traffic || traffic.topPages.length === 0 ? (
            <p class="text-sm text-gray-500">No GA4 page data is available.</p>
          ) : (
            <div class="space-y-3">
              {traffic.topPages.map((page: { page: string; sessions: number; conversions: number }) => (
                <div class="flex items-center justify-between gap-4 border-b border-gray-100 pb-3 last:border-0">
                  <span class="text-sm truncate">{page.page}</span>
                  <span class="text-sm font-semibold whitespace-nowrap">{number(page.sessions)} sessions</span>
                </div>
              ))}
            </div>
          )}
        </div>

        <div class="bg-white rounded-xl shadow-sm p-5 border border-amber-200">
          <h2 class="text-lg font-bold">Lead & Booking Analytics</h2>
          <span class="inline-flex mt-2 text-xs px-2 py-1 rounded-full bg-amber-100 text-amber-800">Retired data source</span>
          <p class="text-sm text-gray-600 mt-4">
            The former lead panel was derived from GoHighLevel contacts. GoHighLevel is no longer the quoting or booking system of record, so those metrics are intentionally not shown.
          </p>
          <p class="text-sm text-gray-600 mt-3">
            Connect BookingKoala reporting here when a supported source is available rather than substituting stale CRM or hand-entered conversion figures.
          </p>
        </div>
      </section>

      <section class="bg-white rounded-xl shadow-sm p-5">
        <h2 class="text-lg font-bold mb-4">Source Links</h2>
        <div class="flex flex-wrap gap-3">
          <a href="https://search.google.com/search-console" target="_blank" rel="noopener noreferrer" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-lg text-sm">Google Search Console →</a>
          <a href="https://analytics.google.com" target="_blank" rel="noopener noreferrer" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-lg text-sm">Google Analytics →</a>
          <a href="https://business.google.com" target="_blank" rel="noopener noreferrer" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-lg text-sm">Google Business Profile →</a>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
