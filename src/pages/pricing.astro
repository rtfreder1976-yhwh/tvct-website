                />
                <span class="text-gray-700">Restock essentials checklist</span>
              </li>
              <li class="flex items-start">
                <Icon
                  name="check-circle"
                  class="w-5 h-5 text-green-500 mr-3 mt-1"
                />
                <span class="text-gray-700">Photo documentation available</span>
              </li>
              <li class="flex items-start">
                <Icon
                  name="check-circle"
                  class="w-5 h-5 text-green-500 mr-3 mt-1"
                />
                <span class="text-gray-700">Priority scheduling for hosts</span>
              </li>
            </ul>
          </div>
          <div
            class="text-center bg-gradient-to-br from-[#FFA985]/10 to-[#FFC67D]/10 rounded-xl p-6"
          >
            <p class="text-gray-600 mb-2">Turnover Cleaning</p>
            <p class="text-xs text-gray-400">Base rate from</p>
            <div class="text-4xl font-bold text-[#333333] mb-1">$125+</div>
            <p class="text-sm text-gray-500 mb-4">Exact price quoted to your property size</p>
            <a
              href="https://thevalleycleanteam.bookingkoala.com/booknow/office_cleaning"
              class="btn-primary px-6 py-3 rounded-full font-semibold inline-block"
