---
import BaseLayout from "../layouts/BaseLayout.astro";

import TrustBadges from "../components/TrustBadges.astro";
import SchemaMarkup from "../components/SchemaMarkup.astro";
import Icon from "../components/Icon.astro";
import { POLICIES } from "../data/claims";
import {
  SQFT_BRACKETS,
  PRICE_TABLE,
  MINIMUMS,
  RATE_CARD_ROWS,
  priceRangeLabel,
  startingPrice,
} from "../data/pricing";

// The calculator's default state (2,000 sq ft / Deep Cleaning) rendered on the
// server. This used to be a hardcoded "$451 - $495" literal that silently went
// stale whenever the price table or the default <option selected> changed;
// deriving it means the pre-JS number is always the number the calculator
// computes, and crawlers that never run JS still read a true price.
const DEFAULT_SIZE = 2000;
const DEFAULT_SERVICE = "deep";
const defaultEstimate = priceRangeLabel(DEFAULT_SERVICE, DEFAULT_SIZE);

// Freshness signal: pricing is a recency-sensitive page. Keep this tied to the
// latest verified pricing/policy revision rather than the deploy clock.
const priceEffectiveDate = "2026-08-11";
const priceEffectiveLabel = new Date(`${priceEffectiveDate}T12:00:00Z`).toLocaleDateString(
  "en-US",
  { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" },
);

const petFeeDisplay = `$${POLICIES.pets.feePerPet}/pet`;
const heavyPetShedDisplay = `+$${POLICIES.pets.heavyShedSurcharge}`;
const travelFeeDisplay = `$${POLICIES.travelFee.minAmount}–$${POLICIES.travelFee.maxAmount}`;
const cancellationFeeDisplay = `$${POLICIES.cancellation.feeAmount}`;

// Offer schema built from the same table the page renders, so the structured
// prices and the visible rate card can never disagree.
const offerSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://thevalleycleanteam.com/pricing#service",
  name: "House Cleaning Services",
  serviceType: "House Cleaning",
  provider: { "@id": "https://thevalleycleanteam.com/#organization" },
  areaServed: [
    "Huntsville, AL", "Madison, AL", "Athens, AL", "Decatur, AL",
    "Florence, AL", "Muscle Shoals, AL", "Mountain Brook, AL",
    "Birmingham, AL", "Nashville, TN",
  ],
  offers: Object.entries({
    regular: "Regular Cleaning",
    deep: "Deep Cleaning",
    moveinout: "Move In/Out Cleaning",
    postconstruction: "Post-Construction Cleaning",
  }).map(([key, label]) => ({
    "@type": "Offer",
    name: label,
    priceSpecification: {
      "@type": "PriceSpecification",
      priceCurrency: "USD",
      minPrice: startingPrice(key),
      maxPrice: PRICE_TABLE[key][PRICE_TABLE[key].length - 1],
      valueAddedTaxIncluded: false,
    },
    priceValidUntil: "2026-12-31",
    availability: "https://schema.org/InStock",
    url: "https://thevalleycleanteam.com/pricing",
  })),
};

// AggregateOffer carries the whole published span in one machine-readable node.
// The site had no lowPrice/highPrice anywhere before this; answer engines
// quoting "what does X cost" want a bounded range, not a single "starting at".
// Kept separate from the per-service Offers above so each still carries its own
// min/max, and both ends derive from the rate card so they cannot drift.
const aggregateOfferSchema = {
  "@context": "https://schema.org",
  "@type": "AggregateOffer",
  "@id": "https://thevalleycleanteam.com/pricing#aggregateoffer",
  itemOffered: { "@id": "https://thevalleycleanteam.com/pricing#service" },
  priceCurrency: "USD",
  lowPrice: Math.min(
    ...["regular", "deep", "moveinout", "postconstruction"].map(startingPrice),
  ),
  highPrice: Math.max(
    ...["regular", "deep", "moveinout", "postconstruction"].map(
      (k) => PRICE_TABLE[k][PRICE_TABLE[k].length - 1],
    ),
  ),
  offerCount: RATE_CARD_ROWS.length * 4,
  availability: "https://schema.org/InStock",
  url: "https://thevalleycleanteam.com/pricing",
};
---

<BaseLayout
  title="Cleaning Prices | Valley Clean Team"
  description="Transparent cleaning service pricing in Alabama & Tennessee. Affordable maid service quotes for Huntsville, Nashville, Mountain Brook & more. No hidden fees!"
  ogImage="https://thevalleycleanteam.com/og-image.png"
>
  <SchemaMarkup type="organization" />
  <script type="application/ld+json" set:html={JSON.stringify(offerSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(aggregateOfferSchema)} />

  <!-- Hero Section -->
  <section class="pt-32 pb-12 px-6">
    <div class="container mx-auto text-center">
      <div
        class="inline-block bg-gradient-to-r from-green-100 to-green-50 px-4 py-2 rounded-full mb-4"
      >
        <span class="text-green-700 font-semibold">
          <Icon name="tag" class="w-5 h-5 mr-2" />Transparent Pricing - No
          Hidden Fees
        </span>
      </div>
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 text-[#333333]"
      >
        Simple, <span class="gold-gradient">Honest Pricing</span>
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-8">
        Every home is different — so every price is too. We show you real base rates so you can budget with confidence, then quote your exact price before we ever start. No surprises. No pressure.
      </p>
      <TrustBadges variant="inline" />
    </div>
  </section>

  <!-- Pricing Calculator -->
  <section class="py-12 px-6 bg-gray-50">
    <div class="container mx-auto max-w-4xl">
      <div
        class="bg-white rounded-2xl p-8 shadow-xl border-2 border-[#FFA985]/20"
      >
        <h2 class="text-3xl font-bold text-center mb-2 text-[#333333]">
          <Icon name="calculator" class="w-5 h-5 text-[#FFA985] mr-3" />Instant
          Price Estimate
        </h2>
        <p class="text-center text-gray-600 mb-8">
          Get a ballpark range in seconds — we confirm your exact price before we start
        </p>

        <div class="grid md:grid-cols-2 gap-6 mb-8">
          <div>
            <label for="homeSize" class="block text-gray-700 font-semibold mb-2"
              >Home Size (sq ft)</label
            >
            <select
              id="homeSize"
              class="w-full px-4 py-3 rounded-lg bg-gray-50 border border-gray-300 text-gray-900 focus:outline-none focus:border-[#FFA985]"
            >
              <option value="1000">Under 1,000 sq ft</option>
              <option value="1500">1,000 - 1,500 sq ft</option>
              <option value="2000" selected>1,500 - 2,000 sq ft</option>
              <option value="2500">2,000 - 2,500 sq ft</option>
              <option value="3000">2,500 - 3,000 sq ft</option>
              <option value="3500">3,000 - 3,500 sq ft</option>
              <option value="4000">3,500+ sq ft</option>
            </select>
          </div>
          <div>
            <label for="bedrooms" class="block text-gray-700 font-semibold mb-2"
              >Number of Bedrooms</label
            >
            <select
              id="bedrooms"
              class="w-full px-4 py-3 rounded-lg bg-gray-50 border border-gray-300 text-gray-900 focus:outline-none focus:border-[#FFA985]"
            >
              <option value="1">1 Bedroom</option>
              <option value="2">2 Bedrooms</option>
              <option value="3" selected>3 Bedrooms</option>
              <option value="4">4 Bedrooms</option>
              <option value="5">5+ Bedrooms</option>
            </select>
          </div>
          <div>
            <label
              for="bathrooms"
              class="block text-gray-700 font-semibold mb-2"
              >Number of Bathrooms</label
            >
            <select
              id="bathrooms"
              class="w-full px-4 py-3 rounded-lg bg-gray-50 border border-gray-300 text-gray-900 focus:outline-none focus:border-[#FFA985]"
            >
              <option value="1">1 Bathroom</option>
              <option value="2" selected>2 Bathrooms</option>
              <option value="3">3 Bathrooms</option>
              <option value="4">4+ Bathrooms</option>
            </select>
          </div>
          <div>
            <label
              for="serviceType"
              class="block text-gray-700 font-semibold mb-2">Service Type</label
            >
            <select
              id="serviceType"
              class="w-full px-4 py-3 rounded-lg bg-gray-50 border border-gray-300 text-gray-900 focus:outline-none focus:border-[#FFA985]"
            >
              <option value="regular">Regular Cleaning</option>
              <option value="deep" selected>Deep Cleaning</option>
              <option value="moveinout">Move In/Out Cleaning</option>
            </select>
          </div>
        </div>

        <div
          class="bg-gradient-to-r from-[#FFA985]/10 to-[#FFC67D]/10 rounded-xl p-6 text-center mb-6"
        >
          <p class="text-gray-600 mb-2">Your Estimated Price Range</p>
          <div class="text-5xl font-bold text-[#333333]" id="priceEstimate">
            {defaultEstimate}
          </div>
          <p class="text-sm text-gray-500 mt-2">
            This is a ballpark range based on what you entered. Your exact quote depends on your home's current condition, layout, and any add-ons. We confirm your final price before we start.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="tel:2568261100"
            class="btn-primary px-8 py-4 rounded-full text-lg font-semibold text-center shadow-lg"
          >
            <Icon name="phone" class="w-5 h-5 mr-2" />Call for Exact Quote
          </a>
          <a
            href="tel:2568261100"
            class="px-8 py-4 rounded-full text-lg font-semibold text-center border-2 border-[#FFA985] text-[#FFA985] hover:bg-[#FFA985] hover:text-white transition"
          >
            <Icon name="phone" class="w-5 h-5 mr-2" />Get Your Free Quote
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Published rate card.
       Rendered server-side from src/data/pricing.ts. Before this existed the
       full square-footage table lived only inside the calculator's JS bundle,
       so an assistant reading the HTML could quote "from $200" but not a single
       real price for a real home size. Every bracket is now plain text. -->
  <section class="py-16 px-6 bg-white" id="rate-card">
    <div class="container mx-auto max-w-4xl">
      <div class="text-center mb-8">
        <h2 class="text-3xl md:text-4xl font-bold mb-4 text-[#333333]">
          How much does house cleaning cost by home size?
        </h2>
        <div class="section-divider"></div>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          A 1,500 sq ft home is <strong>${RATE_CARD_ROWS[3].regular}</strong> for
          a regular clean, <strong>${RATE_CARD_ROWS[3].deep}</strong> for a deep
          clean, and <strong>${RATE_CARD_ROWS[3].moveinout}</strong> for a
          move-in/out. Full rates by square footage are below — these are our
          published prices across Alabama and Tennessee, the same numbers the
          booking form uses. No "starting at," no in-home sales visit before you
          get a number.
        </p>
        <p class="text-sm text-gray-500 mt-3">
          Prices effective{" "}
          <time datetime={priceEffectiveDate}>{priceEffectiveLabel}</time> ·
          Recurring service saves up to 30% off the regular rate
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border-2 border-gray-200 shadow-sm">
        <table class="w-full text-left border-collapse bg-white">
          <caption class="sr-only">
            The Valley Clean Team published house cleaning prices by home square
            footage, effective {priceEffectiveLabel}. Prices in US dollars per
            visit.
          </caption>
          <thead>
            <tr class="bg-gray-50 text-[#333333]">
              <th scope="col" class="px-4 py-3 font-semibold">Home size</th>
              <th scope="col" class="px-4 py-3 font-semibold">Regular cleaning</th>
              <th scope="col" class="px-4 py-3 font-semibold">Deep cleaning</th>
              <th scope="col" class="px-4 py-3 font-semibold">Move in/out</th>
              <th scope="col" class="px-4 py-3 font-semibold">Post-construction</th>
            </tr>
          </thead>
          <tbody>
            {RATE_CARD_ROWS.map((row, i) => (
              <tr class={i % 2 ? "bg-gray-50/60" : "bg-white"}>
                <th scope="row" class="px-4 py-3 font-medium text-[#333333]">
                  {row.label}
                </th>
                <td class="px-4 py-3 text-gray-700">${row.regular.toLocaleString()}</td>
                <td class="px-4 py-3 text-gray-700">${row.deep.toLocaleString()}</td>
                <td class="px-4 py-3 text-gray-700">${row.moveinout.toLocaleString()}</td>
                <td class="px-4 py-3 text-gray-700">${row.postconstruction.toLocaleString()}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="text-sm text-gray-500 mt-4 max-w-3xl">
        Prices are per visit and include supplies, equipment, and a
        background-checked team. <strong>Deep cleans and move-in/out cleans
        also include inside the oven and inside the refrigerator</strong> —
        both are paid add-ons on a regular clean. Homes in heavier condition may
        need a deep clean first — we tell you that before you book, not after.
        Final price is confirmed in writing before we start.
      </p>
    </div>
  </section>

  <!-- Pricing Tiers -->
  <section class="py-20 px-6">
    <div class="container mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 text-[#333333]">
          Our Cleaning Packages
        </h2>
        <div class="section-divider"></div>
        <p class="text-xl text-gray-600">
          Choose the service that fits your needs
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        <!-- Regular Cleaning -->
        <div
          class="bg-white rounded-2xl p-8 shadow-lg border-2 border-gray-200 hover:border-[#FFA985] transition-all hover:shadow-xl"
        >
          <div class="text-center mb-6">
            <div
              class="w-16 h-16 mx-auto rounded-full bg-gray-100 flex items-center justify-center mb-4"
            >
              <Icon name="home" class="w-6 h-6 text-[#FFA985]" />
            </div>
            <h3 class="text-2xl font-bold text-[#333333]">Regular Cleaning</h3>
            <p class="text-gray-600 mt-2">Weekly or Bi-Weekly</p>
          </div>
          <div class="text-center mb-6">
            <span
              class="inline-block bg-green-100 text-green-800 text-xs px-2 py-1 rounded-full font-bold mb-2"
              >Save up to 30%</span
            >
            <br />
            <span class="text-gray-500 text-sm">Base rate from</span>
            <div class="text-4xl font-bold text-[#333333]">$200</div>
            <span class="text-gray-500 text-xs">custom quoted to your home</span>
          </div>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">All rooms dusted & vacuumed</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Kitchen surfaces cleaned</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Bathrooms sanitized</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Floors mopped</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Trash emptied</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Beds made</span>
            </li>
          </ul>
          <a
            href="tel:2568261100"
            class="block w-full btn-primary py-3 rounded-full text-center font-semibold"
          >
            Get Quote
          </a>
        </div>

        <!-- Deep Cleaning - Featured -->
        <div
          class="bg-white rounded-2xl p-8 shadow-xl border-2 border-[#FFA985] relative transform md:-translate-y-4"
        >
          <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
            <span
              class="bg-gradient-to-r from-[#FFA985] to-[#FFC67D] text-white px-6 py-2 rounded-full text-sm font-bold shadow-lg"
            >
              MOST POPULAR
            </span>
          </div>
          <div class="text-center mb-6 mt-4">
            <div
              class="w-16 h-16 mx-auto rounded-full bg-gradient-to-br from-[#FFA985] to-[#FFC67D] flex items-center justify-center mb-4"
            >
              <Icon name="sparkles" class="w-6 h-6 text-white" />
            </div>
            <h3 class="text-2xl font-bold text-[#333333]">Deep Cleaning</h3>
            <p class="text-gray-600 mt-2">One-Time or Seasonal</p>
          </div>
          <div class="text-center mb-6">
            <span class="text-gray-500 text-sm">Base rate from</span>
            <div class="text-4xl font-bold text-[#FFA985]">$276</div>
            <span class="text-gray-500 text-xs">custom quoted to your home</span>
          </div>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700"
                ><strong>Everything in Regular</strong>, plus:</span
              >
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Inside appliances cleaned</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Baseboards & door frames</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Light fixtures & ceiling fans</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Window sills & blinds</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Cabinet fronts wiped</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Behind furniture cleaning</span>
            </li>
          </ul>
          <a
            href="tel:2568261100"
            class="block w-full bg-gradient-to-r from-[#FFA985] to-[#FFC67D] text-white py-3 rounded-full text-center font-semibold shadow-lg hover:shadow-xl transition"
          >
            Get Quote
          </a>
        </div>

        <!-- Move In/Out -->
        <div
          class="bg-white rounded-2xl p-8 shadow-lg border-2 border-gray-200 hover:border-[#FFA985] transition-all hover:shadow-xl"
        >
          <div class="text-center mb-6">
            <div
              class="w-16 h-16 mx-auto rounded-full bg-gray-100 flex items-center justify-center mb-4"
            >
              <Icon name="truck-moving" class="w-6 h-6 text-[#FFA985]" />
            </div>
            <h3 class="text-2xl font-bold text-[#333333]">Move In/Out</h3>
            <p class="text-gray-600 mt-2">Get Your Deposit Back</p>
          </div>
          <div class="text-center mb-6">
            <span class="text-gray-500 text-sm">Base rate from</span>
            <div class="text-4xl font-bold text-[#333333]">$351</div>
            <span class="text-gray-500 text-xs">custom quoted to your home</span>
          </div>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700"
                ><strong>Everything in Deep</strong>, plus:</span
              >
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Inside all cabinets & drawers</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Inside closets cleaned</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Oven & fridge deep clean</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">All switch plates & outlets</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Garage sweep (if applicable)</span>
            </li>
          </ul>
          <a
            href="tel:2568261100"
            class="block w-full btn-primary py-3 rounded-full text-center font-semibold"
          >
            Get Quote
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Additional Services -->
  <section class="py-20 px-6 bg-gray-50">
    <div class="container mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 text-[#333333]">
          Add-On Services
        </h2>
        <div class="section-divider"></div>
        <p class="text-xl text-gray-600">
          Customize your clean with these extras
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
        <div
          class="bg-white rounded-xl p-6 shadow-md border border-gray-200 text-center"
        >
          <Icon name="couch" class="w-8 h-8 text-[#FFA985] mb-4" />
          <h4 class="font-bold text-[#333333] mb-2">Inside Fridge</h4>
          <p class="text-2xl font-bold text-[#333333]">+$75</p>
          <p class="text-xs text-gray-400 mt-1">Included in Move In/Out</p>
        </div>
        <div
          class="bg-white rounded-xl p-6 shadow-md border border-gray-200 text-center"
        >
          <Icon name="fire" class="w-8 h-8 text-[#FFA985] mb-4" />
          <h4 class="font-bold text-[#333333] mb-2">Inside Oven</h4>
          <p class="text-2xl font-bold text-[#333333]">+$50</p>
          <p class="text-xs text-gray-400 mt-1">Included in Deep Clean</p>
        </div>
        <div
          class="bg-white rounded-xl p-6 shadow-md border border-gray-200 text-center"
        >
          <Icon name="box" class="w-8 h-8 text-[#FFA985] mb-4" />
          <h4 class="font-bold text-[#333333] mb-2">Inside Dishwasher</h4>
          <p class="text-2xl font-bold text-[#333333]">+$50</p>
        </div>
        <div
          class="bg-white rounded-xl p-6 shadow-md border border-gray-200 text-center"
        >
          <Icon name="window-maximize" class="w-8 h-8 text-[#FFA985] mb-4" />
          <h4 class="font-bold text-[#333333] mb-2">Wet-Wipe Window Blinds</h4>
          <p class="text-2xl font-bold text-[#333333]">+$10/each</p>
