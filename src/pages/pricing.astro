<script define:vars={{ SQFT_BRACKETS: [...SQFT_BRACKETS], PRICE_TABLE, MINIMUMS }}>
  // Price Calculator
  const homeSize = document.getElementById("homeSize");
  const bedrooms = document.getElementById("bedrooms");
  const bathrooms = document.getElementById("bathrooms");
  const serviceType = document.getElementById("serviceType");
  const priceEstimate = document.getElementById("priceEstimate");

  // SQFT_BRACKETS / PRICE_TABLE / MINIMUMS are injected above from
  // src/data/pricing.ts — the same module that renders the visible rate card
  // and the Offer schema. Keeping one source of truth is what stops the
  // interactive estimate from drifting away from the published table.

  function bracketIndex(size) {
    // pick the first bracket >= size, else the largest
    for (let i = 0; i < SQFT_BRACKETS.length; i++) {
      if (size <= SQFT_BRACKETS[i]) return i;
    }
    return SQFT_BRACKETS.length - 1;
  }

  function calculatePrice() {
    if (!homeSize || !serviceType || !priceEstimate) return;

    const size = parseInt(homeSize.value);
    const service = serviceType.value;

    const table = PRICE_TABLE[service] || PRICE_TABLE.regular;
    let price = table[bracketIndex(size)];
    price = Math.max(price, MINIMUMS[service] || 200);

    // Show a tight range around the table price so the on-page number reads as an
    // estimate (final confirmed in BookingKoala / before the clean).
    const low = price;
    const high = Math.round((price * 1.1) / 5) * 5; // ~+10%, rounded to $5
    if (priceEstimate) priceEstimate.textContent = `$${low} - $${high}`;
  }

  homeSize?.addEventListener("change", calculatePrice);
  bedrooms?.addEventListener("change", calculatePrice);
  bathrooms?.addEventListener("change", calculatePrice);
  serviceType?.addEventListener("change", calculatePrice);

  // Honour #service= so a homepage price card lands on its own calculator
  // state. Without this every card opened the default Deep Cleaning estimate,
  // so "Regular cleaning from $200" arrived showing the deep-clean range.
  //
  // This deliberately reads a HASH fragment, not a query string. The old
  // `/pricing?service=regular` links minted three extra crawlable URLs that
  // served byte-identical HTML, which an AI-visibility crawl flagged as a
  // duplicate-content cluster with duplicate <title> tags. Fragments are never
  // sent to the server and are ignored by crawlers, so the preselect behaviour
  // survives without a second indexable URL. The ?service= form is still read
  // as a fallback so older external links and ad destinations keep working.
  function applyServiceFromQuery() {
    const wanted =
      new URLSearchParams(window.location.hash.replace(/^#/, "")).get("service") ||
      new URLSearchParams(window.location.search).get("service");
    if (!wanted || !serviceType) return;
    const select = serviceType;
    if (Array.from(select.options).some((o) => o.value === wanted)) {
      select.value = wanted;
    }
  }

  // Recompute on load so a #service= deep link updates the number. The
  // server-rendered estimate already matches the default selects (both derive
  // from src/data/pricing.ts), so this is a no-op without a fragment.
  applyServiceFromQuery();
  calculatePrice();
</script>
