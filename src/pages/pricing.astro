          <div class="text-center mb-6 mt-4">
            <div
              class="w-16 h-16 mx-auto rounded-full bg-gradient-to-br from-[#FFA985] to-[#FFC67D] flex items-center justify-center mb-4"
            >
              <Icon name="sparkles" class="w-6 h-6 text-white" />
            </div>
            <h3 class="text-2xl font-bold text-[#333333]">Deep Cleaning</h3>
            <p class="text-gray-600 mt-2">One-Time or Seasonal</p>
          </div>
          <div class="text-center mb-6">
            <span class="text-gray-500 text-sm">Base rate from</span>
            <div class="text-4xl font-bold text-[#FFA985]">$276</div>
            <span class="text-gray-500 text-xs">custom quoted to your home</span>
          </div>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700"
                ><strong>Everything in Regular</strong>, plus:</span
              >
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Inside appliances cleaned</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Baseboards & door frames</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Light fixtures & ceiling fans</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Window sills & blinds</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Cabinet fronts wiped</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Behind furniture cleaning</span>
            </li>
          </ul>
          <a
            href="tel:2568261100"
            class="block w-full bg-gradient-to-r from-[#FFA985] to-[#FFC67D] text-white py-3 rounded-full text-center font-semibold shadow-lg hover:shadow-xl transition"
          >
            Get Quote
          </a>
        </div>

        <!-- Move In/Out -->
        <div
          class="bg-white rounded-2xl p-8 shadow-lg border-2 border-gray-200 hover:border-[#FFA985] transition-all hover:shadow-xl"
        >
          <div class="text-center mb-6">
            <div
              class="w-16 h-16 mx-auto rounded-full bg-gray-100 flex items-center justify-center mb-4"
            >
              <Icon name="truck-moving" class="w-6 h-6 text-[#FFA985]" />
            </div>
            <h3 class="text-2xl font-bold text-[#333333]">Move In/Out</h3>
            <p class="text-gray-600 mt-2">Get Your Deposit Back</p>
          </div>
          <div class="text-center mb-6">
            <span class="text-gray-500 text-sm">Base rate from</span>
            <div class="text-4xl font-bold text-[#333333]">$351</div>
            <span class="text-gray-500 text-xs">custom quoted to your home</span>
          </div>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700"
                ><strong>Everything in Deep</strong>, plus:</span
              >
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Inside all cabinets & drawers</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Inside closets cleaned</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Oven & fridge deep clean</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">All switch plates & outlets</span>
            </li>
            <li class="flex items-start">
              <Icon name="check" class="w-5 h-5 text-green-500 mr-3 mt-1" />
              <span class="text-gray-700">Garage sweep (if applicable)</span>
            </li>
          </ul>
          <a
            href="tel:2568261100"
            class="block w-full btn-primary py-3 rounded-full text-center font-semibold"
          >
            Get Quote
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Additional Services -->
  <section class="py-20 px-6 bg-gray-50">
    <div class="container mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 text-[#333333]">
          Add-On Services
        </h2>
        <div class="section-divider"></div>
        <p class="text-xl text-gray-600">
          Customize your clean with these extras
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
        <div
          class="bg-white rounded-xl p-6 shadow-md border border-gray-200 text-center"
        >
          <Icon name="couch" class="w-8 h-8 text-[#FFA985] mb-4" />
          <h4 class="font-bold text-[#333333] mb-2">Inside Fridge</h4>
          <p class="text-sm font-semibold text-gray-500">Priced with your quote</p>
          <p class="text-xs text-gray-400 mt-1">Included in Move In/Out</p>
        </div>
        <div
          class="bg-white rounded-xl p-6 shadow-md border border-gray-200 text-center"
        >
          <Icon name="fire" class="w-8 h-8 text-[#FFA985] mb-4" />
          <h4 class="font-bold text-[#333333] mb-2">Inside Oven</h4>
          <p class="text-sm font-semibold text-gray-500">Priced with your quote</p>
          <p class="text-xs text-gray-400 mt-1">Included in Deep Clean</p>
        </div>
        <div
          class="bg-white rounded-xl p-6 shadow-md border border-gray-200 text-center"
        >
          <Icon name="box" class="w-8 h-8 text-[#FFA985] mb-4" />
          <h4 class="font-bold text-[#333333] mb-2">Inside Dishwasher</h4>
          <p class="text-sm font-semibold text-gray-500">Priced with your quote</p>
        </div>
        <div
          class="bg-white rounded-xl p-6 shadow-md border border-gray-200 text-center"
        >
          <Icon name="window-maximize" class="w-8 h-8 text-[#FFA985] mb-4" />
          <h4 class="font-bold text-[#333333] mb-2">Wet-Wipe Window Blinds</h4>
          <p class="text-sm font-semibold text-gray-500">Priced with your quote</p>
        </div>
        <div
          class="bg-white rounded-xl p-6 shadow-md border border-gray-200 text-center"
        >
          <Icon name="paw" class="w-8 h-8 text-[#FFA985] mb-4" />
          <h4 class="font-bold text-[#333333] mb-2">Pet Fee</h4>
          <p class="text-2xl font-bold text-[#333333]">{petFeeDisplay}</p>
        </div>
        <div
          class="bg-white rounded-xl p-6 shadow-md border border-gray-200 text-center"
        >
          <Icon name="paw" class="w-8 h-8 text-[#FFA985] mb-4" />
          <h4 class="font-bold text-[#333333] mb-2">Extra Pet Hair Shed</h4>
          <p class="text-2xl font-bold text-[#333333]">{heavyPetShedDisplay}</p>
          <p class="text-xs text-gray-400 mt-1">Separate from the per-pet fee</p>
        </div>
        <div
          class="bg-white rounded-xl p-6 shadow-md border border-gray-200 text-center"
        >
          <Icon name="tshirt" class="w-8 h-8 text-[#FFA985] mb-4" />
          <h4 class="font-bold text-[#333333] mb-2">Laundry Service</h4>
          <p class="text-sm font-semibold text-gray-500">Priced with your quote</p>
        </div>
        <div
          class="bg-white rounded-xl p-6 shadow-md border border-gray-200 text-center"
        >
          <Icon name="leaf" class="w-8 h-8 text-[#FFA985] mb-4" />
          <h4 class="font-bold text-[#333333] mb-2">Green Products</h4>
          <p class="text-2xl font-bold text-[#333333]">FREE</p>
          <p class="text-xs text-gray-400 mt-1">Available upon request</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Commercial Pricing -->
  <section class="py-20 px-6">
    <div class="container mx-auto max-w-5xl">
      <div
        class="bg-gradient-to-br from-[#333333] to-[#1a1a2e] rounded-2xl p-8 md:p-12 text-white text-center"
      >
        <div
          class="w-20 h-20 mx-auto rounded-full bg-gradient-to-br from-[#FFA985] to-[#FFC67D] flex items-center justify-center mb-6"
        >
          <Icon name="building" class="w-8 h-8 text-[#333333]" />
        </div>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">
          Commercial & Office Cleaning
        </h2>
        <p class="text-xl text-gray-300 mb-8">
          Commercial pricing is built around your actual facility and cleaning scope.
        </p>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
          <div class="bg-white/10 rounded-xl p-5">
            <p class="text-sm font-bold text-[#FFA985] mb-2">STEP 1</p>
            <h4 class="font-bold text-lg">Square Footage</h4>
            <p class="text-sm text-gray-300 mt-2">Tell us the cleanable square footage of your space.</p>
          </div>
          <div class="bg-white/10 rounded-xl p-5">
            <p class="text-sm font-bold text-[#FFA985] mb-2">STEP 2</p>
            <h4 class="font-bold text-lg">Task List</h4>
            <p class="text-sm text-gray-300 mt-2">Choose the cleaning tasks your facility needs completed.</p>
          </div>
          <div class="bg-white/10 rounded-xl p-5">
            <p class="text-sm font-bold text-[#FFA985] mb-2">STEP 3</p>
            <h4 class="font-bold text-lg">How Many Times Per Week?</h4>
            <p class="text-sm text-gray-300 mt-2">Tell us how often you need service each week.</p>
          </div>
          <div class="bg-white/10 rounded-xl p-5">
            <p class="text-sm font-bold text-[#FFA985] mb-2">STEP 4</p>
            <h4 class="font-bold text-lg">Get Your Quote</h4>
            <p class="text-sm text-gray-300 mt-2">We price the scope from those three inputs and provide your quote.</p>
          </div>
        </div>
        <a
          href="https://thevalleycleanteam.bookingkoala.com/booknow/office_cleaning"
          class="inline-block bg-gradient-to-r from-[#FFA985] to-[#FFC67D] text-[#333333] px-8 py-4 rounded-full font-bold text-lg shadow-lg hover:shadow-xl transition"
        >
          <Icon name="building" class="w-5 h-5 mr-2" />Get Your Commercial Quote
        </a>
      </div>
    </div>
  </section>

  <!-- Airbnb/Vacation Rental -->
  <section class="py-20 px-6 bg-gray-50">
    <div class="container mx-auto max-w-4xl">
      <div class="text-center mb-12">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 text-[#333333]">
          Airbnb & Vacation Rental Hosts
        </h2>
        <div class="section-divider"></div>
        <p class="text-xl text-gray-600">
          Fast turnaround to keep your guests happy
        </p>
      </div>

      <div
        class="bg-white rounded-2xl p-8 shadow-lg border-2 border-[#FFA985]/20"
      >
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div>
            <h3 class="text-2xl font-bold text-[#333333] mb-4">
              Check Current Turnover Availability in BookingKoala
            </h3>
            <ul class="space-y-3">
              <li class="flex items-start">
                <Icon
                  name="check-circle"
                  class="w-5 h-5 text-green-500 mr-3 mt-1"
                />
                <span class="text-gray-700"
                  >Guest-ready cleaning in 2-4 hours</span
                >
              </li>
              <li class="flex items-start">
                <Icon
                  name="check-circle"
                  class="w-5 h-5 text-green-500 mr-3 mt-1"
                />
                <span class="text-gray-700">Fresh linens & towels setup</span>
