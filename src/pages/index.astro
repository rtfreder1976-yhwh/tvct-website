---
import BaseLayout from "../layouts/BaseLayout.astro";
import TestimonialsSection from "../components/TestimonialsSection.astro";
import ReviewBadges from "../components/ReviewBadges.astro";
import BeforeAfterGallery from "../components/BeforeAfterGallery.astro";
import ServiceAreaMap from "../components/ServiceAreaMap.astro";
import TrustBadges from "../components/TrustBadges.astro";
import ResponseTimeStats from "../components/ResponseTimeStats.astro";
import BookingCTA from "../components/BookingCTA.astro";
import Icon from "../components/Icon.astro";
import {
  PERFORMANCE,
  PRICING,
  RECURRING_DISCOUNTS,
  REVIEWS,
} from "../data/claims";
import { BUSINESS_HOURS, MARKET_PHONES } from "../constants/schemaData";

const pct = (value: number) => `${Math.round(value * 100)}%`;
const alPhone = MARKET_PHONES.AL;

const faqs = [
  {
    question: "How much does house cleaning cost?",
    answer:
      `Base rates start from ${PRICING.regular.display} for regular cleaning, ` +
      `${PRICING.deep.display} for deep cleaning, and ${PRICING.moveInOut.display} ` +
      "for move-in/out cleaning. Your exact price depends on home size and condition, and we confirm it before service.",
  },
  {
    question: "What areas do you serve?",
    answer:
      "We serve homes and businesses across North Alabama, the Shoals, Mountain Brook, and the Nashville area. Use the location pages or online quote flow to confirm service for your address.",
  },
  {
    question: "Are your cleaners background checked and insured?",
    answer:
      "Yes. Our team is background-checked, and The Valley Clean Team carries $2 million in liability coverage and bonded protection.",
  },
  {
    question: "How far in advance should I book a cleaning?",
    answer:
      `Booking earlier gives you the best choice of times. Quote requests are answered within ${PERFORMANCE.quoteResponseSla} during business hours, and short-notice requests are handled based on availability.`,
  },
  {
    question: "Do you bring your own cleaning supplies?",
    answer:
      "Yes. We bring the supplies and equipment needed for the service. If you have product sensitivities or specific surface requirements, tell us when booking.",
  },
  {
    question: "Do you offer discounts for recurring services?",
    answer:
      `Yes. The current recurring schedule is ${pct(RECURRING_DISCOUNTS.weekly)} off weekly, ` +
      `${pct(RECURRING_DISCOUNTS.biweekly)} off biweekly, and ${pct(RECURRING_DISCOUNTS.monthly)} off monthly service, subject to applicable minimums.`,
  },
];

const serviceCards = [
  { href: "/services/regular-cleaning", icon: "home", name: "Regular Cleaning", copy: "Weekly, biweekly, or monthly maintenance with a consistent team." },
  { href: "/services/deep-cleaning", icon: "sparkles", name: "Deep Cleaning", copy: "A detailed reset for first visits, seasonal cleaning, and built-up areas." },
  { href: "/services/move-in-out-cleaning", icon: "truck", name: "Move In/Out Cleaning", copy: "Detailed cleaning for an empty home before or after a move." },
  { href: "/services/airbnb-cleaning", icon: "bed", name: "Vacation Rental Cleaning", copy: "Turnover cleaning designed around guest-ready presentation." },
  { href: "/services/post-construction-cleaning", icon: "hard-hat", name: "Post-Construction", copy: "Fine-dust and detail cleanup after building or renovation work." },
  { href: "/services/commercial-cleaning", icon: "building", name: "Commercial Cleaning", copy: "Reliable office and facility cleaning with custom quoting." },
];

const locations = [
  ["Huntsville", "/locations/huntsville", "Alabama"],
  ["Madison", "/locations/madison", "Alabama"],
  ["Athens", "/locations/athens", "Alabama"],
  ["Florence", "/locations/florence", "Alabama"],
  ["Mountain Brook", "/locations/mountain-brook", "Alabama"],
  ["Nashville", "/locations/nashville", "Tennessee"],
] as const;
---

<BaseLayout
  title="Your Exact Price on the Call | The Valley Clean Team"
  description={`Most cleaners make you wait days for a number that changes. We quote a firm flat price on the phone — and that is the price you pay. ${REVIEWS.rating}★ from ${REVIEWS.countDisplay} reviews.`}
  ogImage="https://thevalleycleanteam.com/og-image.png"
  faqs={faqs}
>
  <link slot="preload" rel="preload" href="/images/hero-400w.avif" as="image" fetchpriority="high" type="image/avif" media="(max-width: 1023px)" />
  <link slot="preload" rel="preload" href="/images/hero-1280w.avif" as="image" fetchpriority="high" type="image/avif" media="(min-width: 1024px)" />

  <section class="pt-24 pb-20 px-6 relative overflow-hidden">
    <div class="absolute inset-0 z-0 overflow-hidden">
      <img
        src="/images/hero-1280w.avif"
        srcset="/images/hero-400w.avif 400w, /images/hero-1280w.avif 1280w"
        sizes="100vw"
        alt="Professional cleaning team providing home cleaning services"
        class="w-full h-full object-cover opacity-75 hidden lg:block"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="1280"
        height="720"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-white/80 via-white/60 to-white"></div>
    </div>

    <div class="container mx-auto relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 items-center mb-16">
        <div class="text-center lg:text-left">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight text-[#333333]">
            We&rsquo;re not the cheapest cleaning company in Alabama or Tennessee. <span class="gold-gradient">That&rsquo;s intentional.</span>
          </h1>
          <p class="text-xl md:text-2xl text-gray-700 mb-8">
            You&rsquo;re paying for a 44-item checklist that gets run the same way every visit, cleaners who are background-checked and insured for $2 million, and a company that answers the phone. Speaking of which: tell us your square footage and the kind of clean you need, and we&rsquo;ll give you your exact price on the first call. Not a starting point &mdash; the number on your bill.
          </p>

          <div class="lg:hidden mb-6">
            <a href="tel:2568261100" class="btn-primary w-full py-4 rounded-full text-lg font-semibold shadow-lg flex items-center justify-center">
              <Icon name="phone" class="w-5 h-5 mr-2" />Get your price
            </a>
            <p class="text-center text-sm text-gray-500 mt-2">Regular cleaning from {PRICING.regular.display} &middot; {REVIEWS.rating} stars from {REVIEWS.countDisplay} Google reviews &middot; Missed a spot? Tell us within 24 hours and we&rsquo;ll come back and fix it, free.</p>
          </div>

          <div class="mb-8 lg:hidden">
            <img src="/images/hero-400w.avif" alt="The Valley Clean Team cleaning a home" class="w-full max-w-md mx-auto rounded-2xl shadow-xl" loading="eager" fetchpriority="high" width="400" height="267" />
          </div>

          <div class="flex flex-wrap gap-5 justify-center lg:justify-start text-lg">
            <a href={alPhone.href} class="flex items-center text-gray-700 hover:text-[#FFA985] transition">
              <Icon name="phone" class="w-5 h-5 text-[#FFA985] mr-2" /><span class="font-semibold">{alPhone.display}</span>
            </a>
            <a href={`sms:+1${alPhone.href.replace(/\D/g, "")}`} class="flex items-center text-gray-700 hover:text-[#FFA985] transition">
              <Icon name="comments" class="w-5 h-5 text-[#FFA985] mr-2" /><span class="font-semibold">Text Us</span>
            </a>
            <a href="mailto:hello@thevalleycleanteam.com" class="flex items-center text-gray-700 hover:text-[#FFA985] transition">
              <Icon name="envelope" class="w-5 h-5 text-[#FFA985] mr-2" /><span class="font-semibold">Email Us</span>
            </a>
          </div>
          <p class="text-sm text-gray-500 mt-4">Quote requests answered within {PERFORMANCE.quoteResponseSla}.</p>
        </div>

        <BookingCTA variant="card" />
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-3xl mx-auto">
        <div class="text-center"><div class="text-4xl font-bold text-[#FFA985] mb-2">{PERFORMANCE.avgCleanerExperienceYears} yrs</div><p class="text-gray-600">Avg. Cleaner Experience</p></div>
        <div class="text-center"><div class="text-4xl font-bold text-[#FFA985] mb-2">{PERFORMANCE.customersServedDisplay}</div><p class="text-gray-600">Customers Served</p></div>
        <div class="text-center"><div class="text-4xl font-bold text-[#FFA985] mb-2">{REVIEWS.rating}★</div><p class="text-gray-600">From {REVIEWS.countDisplay} Google Reviews</p></div>
      </div>
    </div>
  </section>

  <section class="px-6 pb-8">
    <div class="container mx-auto max-w-4xl">
      <div class="grid sm:grid-cols-3 gap-4 mb-4">
        <a href="/pricing#service=regular" class="bg-white rounded-2xl p-6 border-2 border-gray-200 hover:border-[#FFA985] transition text-center">
          <p class="text-sm text-gray-500 mb-1">Regular cleaning</p><p class="text-3xl font-bold text-[#333333]">from {PRICING.regular.display}</p>
        </a>
        <a href="/pricing#service=deep" class="bg-white rounded-2xl p-6 border-2 border-[#FFA985] hover:bg-[#FFA985]/5 transition text-center">
          <p class="text-sm text-gray-500 mb-1">Deep cleaning</p><p class="text-3xl font-bold text-[#333333]">from {PRICING.deep.display}</p>
        </a>
        <a href="/pricing#service=moveinout" class="bg-white rounded-2xl p-6 border-2 border-gray-200 hover:border-[#FFA985] transition text-center">
          <p class="text-sm text-gray-500 mb-1">Move in/out</p><p class="text-3xl font-bold text-[#333333]">from {PRICING.moveInOut.display}</p>
        </a>
      </div>
      <p class="text-center text-sm text-gray-500">Final price depends on your home's size and condition. <a href="/pricing" class="text-[#FFA985] font-semibold hover:underline">See full pricing</a>.</p>
    </div>
  </section>

  <TrustBadges variant="section" />

  <section class="py-12 px-6 bg-gray-50"><div class="container mx-auto max-w-4xl"><ReviewBadges /></div></section>

  <section id="services" class="py-20 px-6 bg-gray-50 content-visibility-auto">
    <div class="container mx-auto">
      <div class="text-center mb-14"><h2 class="text-4xl md:text-5xl font-bold mb-4 text-[#333333]">Cleaning Services</h2><div class="section-divider"></div><p class="text-xl text-gray-600">Choose the service that fits the job.</p></div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {serviceCards.map((card) => (
          <a href={card.href} class="service-card bg-white rounded-2xl p-7 border border-gray-200 shadow-md block hover:shadow-lg transition-shadow">
            <Icon name={card.icon} class="w-8 h-8 text-[#FFA985] mb-4" />
            <h3 class="text-2xl font-bold mb-3 text-[#333333]">{card.name}</h3>
            <p class="text-gray-600">{card.copy}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 px-6 bg-white">
    <div class="container mx-auto">
      <div class="text-center mb-10"><h2 class="text-3xl md:text-4xl font-bold mb-3 text-[#333333]">Find Cleaning Services <span class="gold-gradient">Near You</span></h2><p class="text-lg text-gray-600">Serving communities across Alabama and Tennessee</p></div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 max-w-6xl mx-auto">
        {locations.map(([name, href, state]) => (
          <a href={href} class="group bg-gray-50 rounded-xl p-5 border border-gray-200 hover:border-[#FFA985] hover:shadow-md transition text-center">
            <Icon name="map-marker" class="w-6 h-6 text-[#FFA985] mx-auto mb-2" /><h3 class="font-bold text-[#333333] group-hover:text-[#FFA985] transition">{name}</h3><p class="text-xs text-gray-500 mt-1">{state}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div style="content-visibility:auto;contain-intrinsic-size:0 800px"><BeforeAfterGallery /></div>
  <div style="content-visibility:auto;contain-intrinsic-size:0 600px"><TestimonialsSection /></div>
  <div style="content-visibility:auto;contain-intrinsic-size:0 500px"><ServiceAreaMap /></div>
  <div style="content-visibility:auto;contain-intrinsic-size:0 400px"><ResponseTimeStats /></div>

  <section class="py-20 px-6 bg-gray-50">
    <div class="container mx-auto max-w-4xl">
      <div class="text-center mb-14"><h2 class="text-4xl md:text-5xl font-bold mb-4 text-[#333333]">Frequently Asked Questions</h2><div class="section-divider"></div></div>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="bg-white rounded-xl p-6 shadow-md border border-gray-200">
            <summary class="font-bold text-[#333333] cursor-pointer">{faq.question}</summary>
            <p class="text-gray-600 mt-4">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="py-20 px-6 bg-gradient-to-br from-[#FFA985]/10 to-white">
    <div class="container mx-auto max-w-4xl text-center">
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-[#333333]">Ready for a cleaner home?</h2>
      <div class="section-divider"></div>
      <p class="text-xl text-gray-600 mb-8">See your price online, or call us during business hours.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-5">
        <a href="tel:2568261100" class="btn-primary px-8 py-4 rounded-full text-lg font-semibold">Get your price</a>
        <a href={alPhone.href} class="px-8 py-4 rounded-full text-lg font-semibold border-2 border-[#333333] text-[#333333]">Call {alPhone.display}</a>
      </div>
      <p class="text-sm text-gray-500">{BUSINESS_HOURS.display} · Quote response SLA: {PERFORMANCE.quoteResponseSla}</p>
    </div>
  </section>
</BaseLayout>
